		>
			<span style="--color: #28190a"></span>
			<span style="--color: #6d6853"></span>
			<span style="--color: #704c32"></span>
			<span style="--color: #a57a4f"></span>
			<span style="--color: #c69c70"></span>
		</div>
	</div>
</section>


<!-- =====================================================
     REGALOS
===================================================== -->

<section
	class="section gifts"
	id="regalos"
	data-reveal
>
	<div
		class="gifts__content"
		data-reveal-child
	>
		<div
			class="
				section-heading
				section-heading--left
			"
		>
			<span>
				Con mucho cariño
			</span>

			<h2>
				{regalos.titulo}
			</h2>
		</div>

		<p>
			{regalos.mensaje}
		</p>

		<div class="gifts__event">
			<span>
				{regalos.tienda}
			</span>

			<strong>
				Evento {regalos.numeroEvento}
			</strong>
		</div>

		{
			regalos.url !== '#' && (
				<a
					class="button button--olive"
					href={regalos.url}
					target="_blank"
					rel="noreferrer"
				>
					Ver mesa de regalos
				</a>
			)
		}
	</div>

	<div
		class="gifts__monogram"
		aria-hidden="true"
		data-reveal-child
	>
		{pareja.novio.charAt(0)}
		&amp;
		{pareja.novia.charAt(0)}
	</div>
</section>


<!-- =====================================================
     AVISOS
===================================================== -->

<section
	class="section notices"
	aria-label="Información adicional"
	data-reveal
>
	<div
		class="notices__decoration notices__decoration--one"
		aria-hidden="true"
	></div>

	<div
		class="notices__decoration notices__decoration--two"
		aria-hidden="true"
	></div>

	<div
		class="section-heading notices__heading"
		data-reveal-child
	>
		<span>
			Información importante
		</span>

		<h2>
			Antes de acompañarnos
		</h2>

		<div
			class="heading-ornament heading-ornament--notices"
			aria-hidden="true"
		>
			<span></span>
			<small>✦</small>
			<span></span>
		</div>
	</div>

	<div class="notices__grid">
		{
			avisos.map((aviso, index) => (
				<article
					data-reveal-notice
					style={`--notice-delay: ${index * 120}ms`}
				>
					<div
						class="notices__number"
						aria-hidden="true"
					>
						0{index + 1}
					</div>

					<h3>
						{aviso.titulo}
