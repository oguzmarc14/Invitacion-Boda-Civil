	/* =====================================================
	   REVEALS
	===================================================== */

	[data-reveal-child] {
		opacity:
			0;

		transform:
			translateY(
				2rem
			);

		transition:
			opacity 900ms ease,
			transform 1000ms
			cubic-bezier(
				0.22,
				1,
				0.36,
				1
			);
	}


	.is-revealed
	[data-reveal-child] {
		opacity:
			1;

		transform:
			translateY(0);
	}

	[data-reveal-gallery],
	[data-reveal-timeline],
	[data-reveal-notice] {
		opacity: 0;
	}

	.is-revealed [data-reveal-gallery],
	.is-revealed [data-reveal-timeline],
	.is-revealed [data-reveal-notice] {
		opacity: 1;
	}

	/*
	 * La sección permanece visible en todo momento.
	 * La clase is-revealed activa solamente sus cards y textos.
	 */
	[data-reveal] {
		opacity: 1;
	}

	.section,
	.closing {
		:where(
			h1,
			h2,
			h3,
			p,
			span,
			strong,
			small,
			time,
			a,
			button,
			label,
			li
		) {
			text-shadow: 0 1px 3px rgba(40, 25, 10, 0.28);
		}
	}


	.is-revealed
	[data-reveal-gallery] {
		animation:
			reveal-up
			900ms
			var(--gallery-delay)
			both;
	}


	.is-revealed
	[data-reveal-timeline] {
		animation:
			reveal-left
			850ms
			var(--timeline-delay)
			both;
	}


	.is-revealed
	[data-reveal-notice] {
		animation:
			reveal-up
			850ms
			var(--notice-delay)
			both;
	}


	@keyframes reveal-up {
		from {
			opacity:
				0;

			transform:
				translateY(
					1.5rem
				);
		}

		to {
			opacity:
				1;

			transform:
				translateY(0);
		}
	}


	@keyframes reveal-left {
		from {
			opacity:
				0;

			transform:
				translateX(
					-1rem
				);
		}

		to {
			opacity:
				1;

			transform:
				translateX(0);
		}
	}


	@keyframes location-float {
		0%,
		100% {
			transform:
				translateY(0);
		}

		50% {
			transform:
				translateY(
					-0.4rem
				);
		}
	}


	/* =====================================================
	   DESKTOP
	===================================================== */

	@media (min-width: 768px) {
		.story {
			grid-template-columns:
				repeat(
					2,
					minmax(
						0,
						1fr
					)
				);

			padding-inline:
				clamp(
					3rem,
					8vw,
					8rem
				);
		}


		.event-countdown {
			grid-template-columns:
				repeat(
					4,
					1fr
				);
		}


		.event__summary {
			grid-template-columns:
				repeat(
					3,
					1fr
				);
		}


		.event__summary > div + div {
			border-top: 0;

			border-left:
				1px solid
				var(--champagne);
		}


		.gallery__grid {
			grid-template-columns:
				1.4fr
				1fr
				1fr;
		}


		.gallery__item,
		.gallery__item--featured {
			grid-column:
				auto;

			height:
				34rem;
		}


		.notices__grid {
			grid-template-columns:
				repeat(
					3,
					1fr
				);
		}
	}


	/* =====================================================
	   MÓVIL
	===================================================== */

	@media (max-width: 390px) {
		.story__signature {
			gap:
				0.25rem;
		}


		.story__signature > span {
			font-size:
				2.35rem;
		}


		.notices__grid article {
			padding:
				1.6rem
				1.4rem;
		}


		.location__actions {
			flex-direction:
				column;
		}


		.location-button {
			width:
				100%;
		}
	}


	/* =====================================================
	   REDUCED MOTION
	===================================================== */

	@media (
		prefers-reduced-motion:
		reduce
	) {
		[data-reveal-child],
		[data-reveal-gallery],
		[data-reveal-timeline],
		[data-reveal-notice] {
			opacity:
				1;

			transform:
				none;

			animation:
				none !important;

			transition:
				none !important;
		}


		.location__pin {
			animation:
				none;
		}
	}

	/* =====================================================
	   CUENTA REGRESIVA — REDISEÑO EDITORIAL
	===================================================== */

	.countdown-section {
		min-height: 84svh;
		overflow: hidden;
		background:
			linear-gradient(
				180deg,
				#ede5da 0%,
				#ede5da 20%,
				var(--ivory) 58%,
				var(--ivory) 92%,
				var(--ivory) 100%
			);
		border: 0;
	}

	.countdown-section__background {
		display: none;
	}

	.countdown-section__overlay {
		background:
			linear-gradient(
				180deg,
				rgba(254, 252, 248, 0.2) 0%,
				transparent 34%,
				rgba(109, 104, 83, 0.04) 68%,
				rgba(40, 25, 10, 0.08) 100%
			);

		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	.countdown-section::before {
		background:
			radial-gradient(
				circle at 8% 12%,
				rgba(222, 199, 173, 0.3),
				transparent 22%
			),
			radial-gradient(
				circle at 96% 84%,
				rgba(109, 104, 83, 0.12),
				transparent 26%
			);
	}

	.countdown-section::after {
		position: absolute;
		right: calc(-4rem - 2px);
		bottom: calc(-11rem + 2px);
		width: 16rem;
		height: 16rem;
		border: 1px solid rgba(109, 104, 83, 0.16);
		border-radius: 50%;
		box-shadow:
			0 0 0 1.5rem rgba(198, 156, 112, 0.08),
			0 0 0 3rem rgba(109, 104, 83, 0.05);
		content: '';
		pointer-events: none;
	}

	.countdown-decoration {
		border:
			1px solid
			rgba(109, 104, 83, 0.12);

		box-shadow: none;
	}

	.countdown-decoration--one {
		top: -9rem;
		right: -7rem;
		width: 16rem;
		height: 16rem;
	}

	.countdown-decoration--two {
		bottom: -7rem;
		left: -7rem;
		width: 16rem;
		height: 16rem;
