			<div class="rsvp-form__choices">
				<label class="rsvp-form__choice">
					<input type="radio" name="attendance" value="si" required />

					<span class="rsvp-form__choice-content">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 12 4.2 4.2L19 6.8"></path>
						</svg>
						<strong>Sí, asistiré</strong>
						<small>Nos dará mucho gusto verte</small>
					</span>
				</label>

				<label class="rsvp-form__choice">
					<input type="radio" name="attendance" value="no" required />

					<span class="rsvp-form__choice-content">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M7 7l10 10M17 7 7 17"></path>
						</svg>
						<strong>No podré asistir</strong>
						<small>Gracias por hacérnoslo saber</small>
					</span>
				</label>
			</div>
		</fieldset>

		<label class="rsvp-form__guests" data-rsvp-guests>
			<span>
				¿Cuántas personas asistirán?
			</span>

			<span class="rsvp-form__select-wrap">
				<select name="guests" required disabled>
					<option value="">Selecciona una cantidad</option>
				</select>

				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="m7 9 5 5 5-5"></path>
				</svg>
			</span>
		</label>

		<button
			class="
				button
				button--olive
				rsvp-form__submit
			"
			type="submit"
			disabled
		>
			<span data-rsvp-submit-text>Confirmar asistencia</span>

			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M5 12h13M14 7l5 5-5 5"></path>
			</svg>
		</button>

		<p class="rsvp-form__privacy">
			Tu respuesta quedará registrada únicamente para la organización de la boda.
		</p>
	</form>
</section>


<!-- =====================================================
     CIERRE
===================================================== -->

<footer
	class="closing"
	data-reveal
>
	<img
		src={imagenes.portada}
		alt=""
		loading="lazy"
		aria-hidden="true"
	/>

	<div class="closing__overlay"></div>

	<div
		class="closing__content"
		data-reveal-child
	>
		<span>
			Gracias por ser parte de nuestra historia
		</span>

		<h2 class="closing__names">
			<div class="closing__name-line">{pareja.novio}</div>
			<small class="closing__ampersand">&amp;</small>
			<div class="closing__name-line">{pareja.novia}</div>
		</h2>

		<p>
			{textos.cierre}
		</p>

		<time datetime={evento.inicio}>
			{evento.fechaLarga}
		</time>
	</div>
</footer>


<script>
	import { supabase } from '../lib/supabase';

	const countdown =
		document.querySelector<HTMLElement>(
			'[data-event-countdown]'
		);

	const eventDate =
		countdown?.dataset.eventDate;

	const targetDate =
		eventDate
			? new Date(eventDate).getTime()
			: Date.now();

	const twoDigits =
		(value: number) =>
			String(value).padStart(2, '0');

	const updateEventCountdown = () => {
		const remaining =
			Math.max(
				0,
				targetDate - Date.now()
			);

		const values = {
			'[data-event-days]':
				String(
					Math.floor(
						remaining / 86_400_000
					)
				),

			'[data-event-hours]':
				twoDigits(
					Math.floor(
						(remaining / 3_600_000) % 24
					)
				),

			'[data-event-minutes]':
				twoDigits(
					Math.floor(
						(remaining / 60_000) % 60
					)
				),

			'[data-event-seconds]':
				twoDigits(
					Math.floor(
						(remaining / 1_000) % 60
					)
				),
		};

		Object.entries(values).forEach(
			([selector, value]) => {
				const element =
					countdown
						?.querySelector<HTMLElement>(
							selector
						);

				if (element) {
					element.textContent =
						value;
				}
			}
		);
	};

	updateEventCountdown();

	const countdownInterval =
		window.setInterval(
			updateEventCountdown,
			1000
		);


	type InvitacionPublica = {
		nombre_invitado: string;
		invitados_permitidos: number;
		asistentes_confirmados: number;
		estado: string;
	};

	const rsvpForm =
		document.querySelector<HTMLFormElement>(
			'[data-rsvp-form]'
		);

	const rsvpNotice =
		rsvpForm?.querySelector<HTMLElement>(
			'[data-rsvp-notice]'
		);

	const nameInput =
		rsvpForm?.elements.namedItem(
			'name'
		) as HTMLTextAreaElement | null;

	const resizeNameField = () => {
		if (!nameInput) return;
		const mobileMinimumHeight = 120;
		const desktopMinimumHeight = 54;
		const minimumHeight = window.matchMedia('(max-width: 767px)').matches
			? mobileMinimumHeight
			: desktopMinimumHeight;

		nameInput.style.height = 'auto';
		nameInput.style.height = `${Math.max(nameInput.scrollHeight, minimumHeight)}px`;
	};

	window.addEventListener('resize', resizeNameField);

	const attendanceInputs =
		Array.from(
			rsvpForm?.querySelectorAll<HTMLInputElement>(
				'input[name="attendance"]'
			) ?? []
		);

	const attendanceFieldset =
		rsvpForm?.querySelector<HTMLFieldSetElement>(
			'[data-rsvp-attendance]'
		);

	const guestsSelect =
		rsvpForm?.elements.namedItem(
			'guests'
		) as HTMLSelectElement | null;

	const guestsField =
		rsvpForm?.querySelector<HTMLElement>(
			'[data-rsvp-guests]'
		);

	const allowanceText =
		rsvpForm?.querySelector<HTMLElement>(
			'[data-rsvp-allowance]'
		);

	const submitButton =
		rsvpForm?.querySelector<HTMLButtonElement>(
			'[type="submit"]'
		);

	const submitText =
		rsvpForm?.querySelector<HTMLElement>(
			'[data-rsvp-submit-text]'
		);

	const pathCode =
		window.location.pathname.match(
			/^\/i\/([^/]+)\/?$/
		)?.[1];

	const invitationCode =
		decodeURIComponent(
			pathCode ??
				new URLSearchParams(
					window.location.search
				).get('codigo') ??
				''
		).trim();

	let currentInvitation:
		| InvitacionPublica
		| null = null;

	const setRsvpNotice = (
		message: string,
		status: 'info' | 'success' | 'error' = 'info'
	) => {
		if (!rsvpNotice) return;
		rsvpNotice.textContent = message;
		rsvpNotice.dataset.status = status;
	};

	const populateGuestOptions = (
		maximum: number,
		selected = 1
	) => {
		if (!guestsSelect) return;

		guestsSelect.replaceChildren();

		for (let amount = 1; amount <= maximum; amount += 1) {
			const option = document.createElement('option');
			option.value = String(amount);
			option.textContent =
				amount === 1
					? '1 persona'
					: `${amount} personas`;
			option.selected = amount === selected;
			guestsSelect.append(option);
		}
	};

	const selectedAttendance = () =>
		attendanceInputs.find(
			(input) => input.checked
		)?.value ?? '';

	const setAttendance = (
		value: 'si' | 'no'
	) => {
		const option = attendanceInputs.find(
			(input) => input.value === value
		);

		if (option) {
			option.checked = true;
		}
	};

	const updateGuestField = () => {
		if (!guestsSelect) return;

		const willAttend =
			selectedAttendance() === 'si';

		guestsSelect.disabled = !willAttend;
		guestsField?.classList.toggle(
			'is-active',
			willAttend
		);
	};

	const loadInvitation = async () => {
		if (!invitationCode) {
			setRsvpNotice(
				'Abre el enlace personalizado que recibiste para confirmar tu asistencia.'
			);
			return;
		}

		setRsvpNotice('Estamos validando tu invitación...');

		const { data, error } = await supabase.rpc(
			'buscar_invitacion',
			{ p_codigo: invitationCode }
		);

		const invitation =
			(data?.[0] ?? null) as InvitacionPublica | null;

		if (error || !invitation) {
			setRsvpNotice(
				'No pudimos encontrar esta invitación. Revisa que el enlace esté completo.',
				'error'
			);
			return;
		}

		currentInvitation = invitation;

		if (nameInput) {
			nameInput.value = invitation.nombre_invitado;
			window.requestAnimationFrame(resizeNameField);
		}

		if (allowanceText) {
			allowanceText.textContent =
				invitation.invitados_permitidos === 1
					? 'Hemos reservado 1 lugar para ti.'
					: `Hemos reservado ${invitation.invitados_permitidos} lugares para ustedes.`;
		}

		if (attendanceFieldset) {
			attendanceFieldset.disabled = false;
		}

		if (guestsSelect) {
			populateGuestOptions(
				invitation.invitados_permitidos,
				Math.max(
					1,
					invitation.asistentes_confirmados || 1
				)
			);
		}

		if (submitButton) {
			submitButton.disabled = false;
		}

		if (invitation.estado === 'confirmado') {
			setAttendance('si');
			updateGuestField();

			if (submitText) {
				submitText.textContent = 'Actualizar mi respuesta';
			}

			setRsvpNotice(
				`Tu respuesta actual es: ${invitation.asistentes_confirmados} ${invitation.asistentes_confirmados === 1 ? 'persona confirmada' : 'personas confirmadas'}. Puedes actualizarla si lo necesitas.`,
				'success'
			);
			return;
		}

		if (invitation.estado === 'no_asiste') {
			setAttendance('no');
			updateGuestField();

			if (submitText) {
				submitText.textContent = 'Actualizar mi respuesta';
			}

			setRsvpNotice(
				'Registramos que no podrán acompañarnos. Puedes cambiar tu respuesta si lo necesitas.'
			);
			return;
		}

		updateGuestField();

		setRsvpNotice(
			`Esta invitación permite confirmar hasta ${invitation.invitados_permitidos} ${invitation.invitados_permitidos === 1 ? 'persona' : 'personas'}.`
		);
	};

	attendanceInputs.forEach((input) => {
		input.addEventListener(
			'change',
			updateGuestField
		);
	});

	rsvpForm?.addEventListener(
		'submit',
		async (event) => {
			event.preventDefault();

			if (
				!currentInvitation ||
				!guestsSelect ||
				!submitButton
			) {
				return;
			}

			const attendance = selectedAttendance();

			if (!attendance) {
				setRsvpNotice(
					'Indica si podrás acompañarnos.',
					'error'
				);
				return;
			}

			const willAttend = attendance === 'si';

			const attendees = willAttend
				? Number(guestsSelect.value)
				: 0;

			if (
				!Number.isInteger(attendees) ||
				attendees < 0 ||
				attendees > currentInvitation.invitados_permitidos
			) {
				setRsvpNotice(
					'Selecciona una cantidad válida de asistentes.',
					'error'
				);
				return;
			}

			submitButton.disabled = true;

			if (submitText) {
				submitText.textContent = 'Guardando respuesta…';
			}

			const { data, error } = await supabase.rpc(
				'confirmar_asistencia',
				{
					p_codigo: invitationCode,
					p_asistentes: attendees,
				}
			);

			submitButton.disabled = false;

			if (submitText) {
				submitText.textContent = 'Confirmar asistencia';
			}

			if (error || data !== true) {
				setRsvpNotice(
					'No pudimos guardar tu respuesta. Inténtalo nuevamente.',
					'error'
				);
				return;
			}

			currentInvitation.asistentes_confirmados = attendees;
			currentInvitation.estado =
				attendees === 0
					? 'no_asiste'
					: 'confirmado';

			if (submitText) {
				submitText.textContent = 'Actualizar mi respuesta';
			}

			setRsvpNotice(
				attendees === 0
					? 'Tu respuesta se guardó correctamente. Gracias por avisarnos.'
					: `¡Gracias! Confirmamos la asistencia de ${attendees} ${attendees === 1 ? 'persona' : 'personas'}.`,
				'success'
			);
		}
	);

	void loadInvitation();


	const revealSections =
		document.querySelectorAll<HTMLElement>(
			'[data-reveal]'
		);

	const observer =
		new IntersectionObserver(
			(entries) => {
				entries.forEach(
					(entry) => {
						if (!entry.isIntersecting) {
							return;
						}

						entry.target.classList.add(
							'is-revealed'
						);

						observer.unobserve(
							entry.target
						);
					}
				);
			},
			{
				threshold: 0.12,
				rootMargin:
					'0px 0px -5% 0px',
			}
		);

	revealSections.forEach(
		(section) => {
			observer.observe(section);
		}
	);


	document.addEventListener(
		'astro:before-swap',
		() => {
			window.clearInterval(
				countdownInterval
			);

			observer.disconnect();
		},
		{
			once: true,
		}
	);
</script>


