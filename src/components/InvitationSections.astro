	/* =====================================================
	   SISTEMA VISUAL CONTINUO — OLIVO + VIDRIO

	   Cada sección comienza con el color exacto en el que
	   termina la anterior. La sección Historia permanece
	   intacta; este sistema empieza después de ella.
	===================================================== */

	.countdown-section,
	.gallery,
	.event,
	.location,
	.dress-code,
	.notices,
	.rsvp {
		isolation: isolate;
	}

	.countdown-section {
		background:
			linear-gradient(
				180deg,
				var(--ivory) 0%,
				#ddd8cc 14%,
				#aaa793 42%,
				#7b7762 70%,
				#dcd4c9 100%
			);
	}

	.countdown-section__overlay {
		background:
			radial-gradient(
				circle at 88% 22%,
				rgba(254, 252, 248, 0.22),
				transparent 28%
			),
			linear-gradient(
				180deg,
				transparent 0%,
				rgba(109, 104, 83, 0.04) 58%,
				rgba(254, 252, 248, 0.1) 100%
			);
	}

	.countdown-section__content {
		width: min(100%, 34rem);
		padding-inline: clamp(1rem, 4vw, 2rem);
		padding-top: max(1.2rem, env(safe-area-inset-top) + 0.8rem);
		transform: translateY(-2rem);
	}

	.countdown-heading {
		padding: 1.15rem 1rem 1.35rem;
		border: 1px solid rgba(254, 252, 248, 0.28);
		border-radius: 1.5rem;
		background:
			linear-gradient(
				145deg,
				rgba(254, 252, 248, 0.24),
				rgba(236, 228, 217, 0.08)
			);
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.52),
			0 1rem 2.5rem rgba(40, 25, 10, 0.08);
		-webkit-backdrop-filter: blur(12px) saturate(120%);
		backdrop-filter: blur(12px) saturate(120%);
	}

	.countdown-heading > span,
	.countdown-heading h2 {
		color: var(--espresso);
	}

	.event-countdown {
		margin-top: 1rem;
	}

