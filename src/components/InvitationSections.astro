		color:
			var(--honey);
	}


	.notices__grid {
		width:
			min(
				100%,
				62rem
			);

		margin:
			0 auto;

		display:
			grid;

		gap:
			1rem;
	}


	.notices__grid article {
		position:
			relative;

		padding:
			1.8rem
			1.6rem;

		overflow:
			hidden;

		border:
