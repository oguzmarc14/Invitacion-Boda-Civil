	/* =====================================================
	   AVISOS - NUEVO DISEÑO
	===================================================== */

	.notices {
		isolation:
			isolate;

		background:
			linear-gradient(
				150deg,
				var(--warm-white)
					0%,

				#f5eee5
					48%,

				var(--ivory)
					100%
			);

		color:
			var(--espresso);
	}


	.notices::before {
		position:
			absolute;

		z-index:
			-2;

		inset:
			0;

		content:
			'';

		background:
			radial-gradient(
				circle at 90% 8%,
				rgba(
					109,
					104,
					83,
					0.11
				),
				transparent 25%
			),

			radial-gradient(
				circle at 5% 85%,
				rgba(
					198,
					156,
					112,
					0.14
				),
				transparent 28%
			);
	}


	.notices__decoration {
		position:
			absolute;

		z-index:
			-1;

		border:
			1px solid
			rgba(
				40,
				25,
				10,
				0.08
			);

		border-radius:
			50%;
	}


	.notices__decoration--one {
		top:
			-8rem;

