---
import type { Invitation } from '../data/invitation';

interface Props {
	invitation: Invitation;
}

const { invitation } = Astro.props;

const {
	pareja: parejaOriginal,
	evento: eventoOriginal,
	textos: textosOriginal,
	imagenes,
	itinerario,
	vestimenta: vestimentaOriginal,
	regalos,
	rsvp,
	avisos,
} = invitation;

const pareja = {
	...parejaOriginal,
	novia: 'Nayzeth Gutiérrez',
	novio: 'Adán Pérez',
};

const evento = {
	...eventoOriginal,
	fechaLarga: '5 de febrero de 2027',
	inicio: eventoOriginal.inicio.replace(
		/^\d{4}-\d{2}-\d{2}/,
		'2027-02-05'
	),
	fin: eventoOriginal.fin.replace(
		/^\d{4}-\d{2}-\d{2}/,
		'2027-02-05'
	),
	salon: 'Salón Los Pavorreales',
	direccion: 'Fernando Montes de Oca S/N, Col. Niños Héroes',
};

const textos = {
	...textosOriginal,
	mensaje:
		'Porque no es la suerte de haber encontrado a alguien perfecto, sino el construir un amor imperfecto de manera perfecta. Sería un honor que las personas más importantes de nuestras vidas nos acompañen en la primera parte de nuestra unión.',
};

const vestimenta = {
	...vestimentaOriginal,
	codigo: 'Semiformal',
};

const calendarDate = (isoDate: string) =>
	new Date(isoDate)
		.toISOString()
		.replace(/[-:]/g, '')
		.replace(/\.\d{3}/, '');

const calendarParams = new URLSearchParams({
	action: 'TEMPLATE',
	text: `${evento.titulo} · ${pareja.novio} & ${pareja.novia}`,
	dates: `${calendarDate(evento.inicio)}/${calendarDate(evento.fin)}`,
	details: `Acompáñanos a celebrar la boda de ${pareja.novio} y ${pareja.novia}.`,
	location: `${evento.salon}, ${evento.direccion}`,
});

const calendarUrl =
	`https://calendar.google.com/calendar/render?${calendarParams.toString()}`;

const guestOptions = Array.from(
	{ length: rsvp.maxAcompanantes + 1 },
	(_, index) => index
);
---

<nav
	class="section-nav"
	aria-label="Secciones de la invitación"
>
	<a href="#historia">Nosotros</a>
	<a href="#galeria">Galería</a>
	<a href="#evento">Evento</a>
	<a href="#ubicacion">Ubicación</a>
	<a href="#confirmacion">Confirmar</a>
</nav>


<!-- =====================================================
     HISTORIA
===================================================== -->

<section
	class="section story"
	id="historia"
	data-reveal
>
	<div
		class="story__photo-wrap"
		data-reveal-child
	>
		<img
			src={imagenes.portada}
			alt={`Fotografía de ${pareja.novio} y ${pareja.novia}`}
			loading="lazy"
		/>

		<span aria-hidden="true">
			Nuestra historia
		</span>
	</div>

	<div
		class="story__content"
		data-reveal-child
	>
		<div
			class="
				section-heading
				story__heading
			"
		>
			<span>
				Un nuevo capítulo
			</span>

			<h3>
				El comienzo de nuestro
			</h3>

			<h3 class="story__forever">
				<em>
					para siempre
				</em>
			</h3>
		</div>


		<p class="story__text">
			{textos.mensaje}
		</p>

		<div class="story__signature">
			<span>{pareja.novia}</span>
			<small>&amp;</small>
			<span>{pareja.novio}</span>
		</div>
	</div>
</section>


<!-- =====================================================
     CUENTA REGRESIVA
===================================================== -->

<section
	class="section countdown-section"
	data-event-countdown
	data-event-date={evento.inicio}
	data-reveal
>
	<img
		src={imagenes.tematica}
		alt="Fondo cuenta regresiva"
		class="countdown-section__background"
		loading="lazy"
		aria-hidden="true"
	/>

	<div class="countdown-section__overlay" aria-hidden="true"></div>

	<div
		class="countdown-decoration countdown-decoration--one"
		aria-hidden="true"
	></div>

	<div
		class="countdown-decoration countdown-decoration--two"
		aria-hidden="true"
	></div>

	<div
		class="countdown-section__content"
	>
		<div
			class="
				section-heading
				countdown-heading
			"
			data-reveal-child
		>
			<span>
				Cada vez falta menos
			</span>

			<h2>
				Cuenta regresiva
			</h2>

			<div
				class="heading-ornament"
				aria-hidden="true"
			>
				<span></span>
				<small>✦</small>
				<span></span>
			</div>
		</div>

		<div
			class="event-countdown"
			aria-label="Cuenta regresiva para la boda"
			data-reveal-child
		>
			<div class="event-countdown__item">
				<div class="event-countdown__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
				</div>
				<strong data-event-days>
					000
				</strong>

				<span>Días</span>
			</div>

			<div class="event-countdown__item">
				<div class="event-countdown__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<circle cx="12" cy="12" r="9"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
				</div>
				<strong data-event-hours>
					00
				</strong>

				<span>Horas</span>
			</div>

			<div class="event-countdown__item">
				<div class="event-countdown__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
						<polyline points="13 2 13 9 20 9"></polyline>
						<line x1="9" y1="13" x2="15" y2="13"></line>
						<line x1="9" y1="18" x2="15" y2="18"></line>
					</svg>
				</div>
				<strong data-event-minutes>
					00
				</strong>

				<span>Minutos</span>
			</div>

			<div class="event-countdown__item">
				<div class="event-countdown__icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<circle cx="12" cy="12" r="9"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
						<circle cx="12" cy="2" r="1.5"></circle>
					</svg>
				</div>
				<strong data-event-seconds>
					00
				</strong>

				<span>Segundos</span>
			</div>
		</div>

		<a
			class="button countdown-button"
			href={calendarUrl}
			target="_blank"
			rel="noreferrer"
			data-reveal-child
		>
			Agregar al calendario
		</a>
	</div>
</section>


<!-- =====================================================
     GALERÍA
===================================================== -->

<section
	class="section gallery"
	id="galeria"
	data-reveal
>
	<div
		class="section-heading"
		data-reveal-child
	>
		<span>
			Instantes que amamos
		</span>

		<h2>
			Nuestra galería
		</h2>

		<p>
			Algunos recuerdos del camino que nos trajo hasta aquí.
		</p>
	</div>

	<div class="gallery__grid">
		{
			imagenes.galeria.map((imagen, index) => (
				<figure
					class:list={[
						'gallery__item',
						{
							'gallery__item--featured':
								index === 0,
						},
					]}
					data-reveal-gallery
					style={`--gallery-delay: ${index * 100}ms`}
				>
					<img
						src={imagen.src}
						alt={imagen.alt}
						loading="lazy"
						style={`object-position: ${imagen.posicion}`}
					/>

					<span aria-hidden="true">
						0{index + 1}
					</span>
				</figure>
			))
		}
	</div>
</section>


<!-- =====================================================
     EVENTO
===================================================== -->

<section
	class="section event"
	id="evento"
	data-reveal
>
	<div
		class="section-heading"
		data-reveal-child
	>
		<span>
			Guarda este momento
		</span>

		<h2>
			Detalles del evento
		</h2>
	</div>

	<div
		class="event__summary"
		data-reveal-child
	>
		<div>
			<span>Día</span>

			<strong>
				{evento.fechaLarga}
			</strong>
		</div>

		<div>
			<span>Ceremonia</span>

			<strong>
				{evento.horaCeremonia}
			</strong>
		</div>

		<div>
			<span>Recepción</span>

			<strong>
				{evento.horaRecepcion}
			</strong>
		</div>
	</div>

	<div
		class="timeline"
		aria-label="Itinerario de la boda"
	>
		{
			itinerario.map((momento, index) => (
				<article
					class="timeline__item"
					data-reveal-timeline
					style={`--timeline-delay: ${index * 120}ms`}
				>
					<div
						class="timeline__marker"
						aria-hidden="true"
					>
						{index + 1}
					</div>

					<time>
						{momento.hora}
					</time>

					<div>
						<h3>
							{momento.titulo}
						</h3>

						<p>
							{momento.detalle}
						</p>
					</div>
				</article>
			))
		}
	</div>
</section>


<!-- =====================================================
     UBICACIÓN
===================================================== -->

<section
	class="section location"
	id="ubicacion"
	data-reveal
>
	<img
		src={imagenes.salon}
		alt="Fondo del salón"
		class="location__background"
		loading="lazy"
		aria-hidden="true"
	/>

	<div class="location__overlay" aria-hidden="true"></div>

	<div
		class="location__ornament location__ornament--one"
		aria-hidden="true"
	></div>

	<div
		class="location__ornament location__ornament--two"
		aria-hidden="true"
	></div>

	<div
		class="location__card"
		data-reveal-child
	>
		<span class="location__eyebrow">
			El lugar donde celebraremos
		</span>

		<div
