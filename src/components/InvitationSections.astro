			translateY(-6px);

		background:
			rgba(
				254,
				252,
				248,
				0.2
			);

		border-color:
			rgba(
				254,
				252,
				248,
				0.5
			);

		box-shadow:
			inset 0 1px 0
			rgba(
				254,
				252,
				248,
				0.6
			),

			inset 0 -1px 0
			rgba(
				40,
				25,
				10,
				0.1
			),

			0 1.2rem 3rem
			rgba(
				198,
				156,
				112,
				0.2
			);
	}


	.event-countdown strong {
		color:
			var(--warm-white);

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			clamp(
				2.8rem,
				11vw,
				4.2rem
			);

		font-weight: 400;

		line-height: 1;

		letter-spacing: -0.02em;
	}


	.event-countdown span {
		margin-top:
			0.8rem;

		color:
			var(--golden-sand);

		font-size:
			0.68rem;

		letter-spacing:
			0.22em;

		text-transform:
			uppercase;

		font-weight: 600;
	}


	.countdown-button {
		background:
			rgba(
				254,
				252,
				248,
				0.15
			);

		color:
			var(--warm-white);

		border:
			1.5px solid
			rgba(
				254,
				252,
				248,
				0.35
			);

		-webkit-backdrop-filter:
			blur(12px);

		backdrop-filter:
			blur(12px);

		transition:
			all 300ms ease;

		box-shadow:
			inset 0 1px 0
			rgba(
				254,
				252,
				248,
				0.4
			),

			0 0.6rem 2rem
			rgba(
				198,
				156,
				112,
				0.12
			);
	}

	.countdown-button:hover {
		background:
			rgba(
				254,
				252,
				248,
				0.25
			);

		border-color:
			rgba(
				254,
				252,
				248,
				0.5
			);

		box-shadow:
			inset 0 1px 0
			rgba(
				254,
				252,
				248,
				0.5
			),

			0 0.8rem 2.5rem
			rgba(
				198,
				156,
				112,
				0.2
			);

		transform: translateY(-2px);
	}


	/* =====================================================
	   BOTONES
	===================================================== */

	.button {
		min-height:
			3rem;

		padding:
			0.85rem
			1.4rem;

		border-radius:
			999px;

		display:
			inline-flex;

		align-items:
			center;

		justify-content:
			center;

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			0.68rem;

		font-weight: 600;

		letter-spacing:
			0.16em;

		text-decoration:
			none;

		text-transform:
			uppercase;

		cursor:
			pointer;

		transition:
			transform 300ms ease,
			box-shadow 300ms ease;
	}


	.button:hover {
		transform:
			translateY(-4px);
	}


	.button--olive {
		border: 0;

		background:
			var(--olive);

		color:
			var(--warm-white);
	}


	/* =====================================================
	   GALERÍA
	===================================================== */

	.gallery {
		position: relative;
		overflow: hidden;
		background:
			linear-gradient(
				180deg,
				#dcd4c9 0%,
				#dcd4c9 78%,
				#dec7ad 100%
			);
	}

	.gallery::before {
		position: absolute;
		top: -5rem;
		right: -4rem;
		width: 16rem;
		height: 16rem;
		border: 1px solid rgba(109, 104, 83, 0.16);
		border-radius: 50%;
		box-shadow:
			0 0 0 1.5rem rgba(198, 156, 112, 0.08),
			0 0 0 3rem rgba(109, 104, 83, 0.05);
		content: '';
		pointer-events: none;
	}

	.gallery::after {
		position: absolute;
		top: 1.5rem;
		left: 50%;
		width: min(72%, 20rem);
		height: 1px;
		background:
			linear-gradient(
				90deg,
				transparent,
				rgba(198, 156, 112, 0.5),
				transparent
			);
		content: '';
		transform: translateX(-50%);
		pointer-events: none;
	}

	.gallery > .section-heading {
		position: relative;
		z-index: 1;
	}


	.gallery__grid {
		width:
			min(
				100%,
				68rem
			);

		margin:
			0 auto;

		display: grid;

		grid-template-columns:
			1fr 1fr;

		gap:
			0.75rem;
	}


	.gallery__item {
		position: relative;

		height:
			15rem;

		margin: 0;

		overflow: hidden;

		opacity: 0;

		transform:
			translateY(2rem);
	}


	.gallery__item--featured {
		grid-column:
			1 / -1;

		height:
			25rem;
	}


	.gallery__item img {
		width: 100%;
		height: 100%;

		display: block;

		object-fit: cover;

		filter:
			saturate(0.82);

		transition:
			transform 900ms ease;
	}


	.gallery__item:hover img {
		transform:
			scale(1.05);
	}


	.gallery__item span {
		position: absolute;

		right:
			0.7rem;

		bottom:
			0.6rem;

		color:
			var(--warm-white);
	}


	/* =====================================================
	   EVENTO
	===================================================== */

	.event {
		background:
			linear-gradient(
				180deg,
				var(--champagne) 0%,
				#e3d6c6 14%,
				#dcd4c9 28%,
				#dcd4c9 52%,
				#E3D0BD 72%,
				#e3d0bd 100%
			);
	}

	.event .section-heading > span,
	.event .section-heading h2 {
		color: var(--espresso);
	}


	.event__summary {
		width:
			min(
				100%,
				56rem
			);

		margin:
			0 auto
			4rem;

		display: grid;

		overflow: hidden;

		border:
			1px solid
			var(--champagne);

		border-radius:
			1rem;

		background:
			var(--ivory);
	}


	.event__summary > div {
		padding:
			1.5rem
			1rem;

		text-align:
			center;
	}


	.event__summary > div + div {
		border-top:
			1px solid
			var(--champagne);
	}


	.event__summary span,
	.event__summary strong {
		display:
			block;
	}


	.event__summary span {
		color:
			var(--olive);

		font-size:
			0.56rem;

		letter-spacing:
			0.2em;

		text-transform:
			uppercase;
	}


	.event__summary strong {
		margin-top:
			0.5rem;

		color:
			var(--espresso);

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			1.2rem;
	}


	.timeline {
		position:
			relative;

		width:
			min(
				100%,
				40rem
			);

		margin:
			0 auto;
	}


	.timeline::before {
		position:
			absolute;

		top:
			1.2rem;

		bottom:
			1.2rem;

		left:
			1.1rem;

		width:
			1px;

		content:
			'';

		background:
			var(--olive);
	}


	.timeline__item {
		position:
			relative;

		padding:
			0 0
			2.25rem
			3.7rem;

		opacity:
			0;
	}


	.timeline__marker {
		position:
			absolute;

		top: 0;
		left: 0;

		width:
			2.2rem;

		height:
			2.2rem;

		border-radius:
			50%;

		display:
			grid;

		place-items:
			center;

		background:
			var(--olive);

		color:
			var(--warm-white);
	}


	.timeline__item time {
		color:
			var(--honey);

		font-size:
			0.62rem;

		letter-spacing:
			0.15em;

		text-transform:
			uppercase;
	}


	.timeline__item h3 {
		margin:
			0.3rem 0 0;

		color:
			var(--espresso);

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			1.3rem;
	}


	.timeline__item p {
		color:
			var(--brown);

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			1rem;

		line-height:
			1.6;
	}

	/* Vidrio reforzado y paleta olivo/espresso para la cuenta regresiva. */
	.countdown-section {
		background:
			linear-gradient(
				135deg,
				rgba(109, 104, 83, 0.32),
				rgba(40, 25, 10, 0.42)
			);
	}

	.countdown-section__overlay {
		background:
			linear-gradient(
				135deg,
				rgba(109, 104, 83, 0.42),
				rgba(40, 25, 10, 0.58)
			);

		-webkit-backdrop-filter: blur(9px) saturate(115%);
		backdrop-filter: blur(9px) saturate(115%);
	}

	.countdown-section__content {
		width: min(92%, 46rem);
		padding:
			clamp(1.25rem, 4vw, 2.4rem)
			clamp(1rem, 4vw, 2.2rem);

		border: 1px solid rgba(254, 252, 248, 0.24);
		border-radius: 2rem;
		background:
			linear-gradient(
				145deg,
				rgba(109, 104, 83, 0.24),
				rgba(40, 25, 10, 0.3)
			);
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.34),
			inset 0 -1px 0 rgba(40, 25, 10, 0.28),
			0 1.25rem 3rem rgba(40, 25, 10, 0.22);

		-webkit-backdrop-filter: blur(14px) saturate(120%);
		backdrop-filter: blur(14px) saturate(120%);
	}

	.event-countdown__item {
		border-color: rgba(254, 252, 248, 0.48);
		background:
			linear-gradient(
				145deg,
				rgba(109, 104, 83, 0.48),
				rgba(109, 104, 83, 0.22)
			);
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.62),
			inset 0 -1px 0 rgba(40, 25, 10, 0.3),
			0 0.8rem 2.5rem rgba(40, 25, 10, 0.24);
	}

	.event-countdown__item:nth-child(even) {
		background:
			linear-gradient(
				145deg,
				rgba(40, 25, 10, 0.5),
				rgba(109, 104, 83, 0.28)
			);
	}

	.event-countdown__icon,
	.event-countdown span {
		color: var(--champagne);
	}

	.countdown-button {
		background:
			linear-gradient(
				135deg,
				rgba(109, 104, 83, 0.58),
				rgba(40, 25, 10, 0.5)
			);
		border-color: rgba(254, 252, 248, 0.48);
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.5),
			0 0.7rem 2rem rgba(40, 25, 10, 0.26);
	}

	/* =====================================================
	   UBICACIÓN
	===================================================== */

	.location {
		isolation:
			isolate;

		position: relative;

		background:
			linear-gradient(
				145deg,
				rgba(119, 115, 97, 0.03),
				rgba(109, 104, 83, 0.02)
			);

		text-align:
			center;
	}

	.location__background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -3;
	}

	.location__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background:
			linear-gradient(
				145deg,
				rgba(119, 115, 97, 0.08),
				rgba(109, 104, 83, 0.06)
			);
		-webkit-backdrop-filter: blur(2px);
		backdrop-filter: blur(2px);
		z-index: -2;
	}

	.location__overlay {
		background:
			linear-gradient(
				180deg,
				rgba(222, 199, 173, 0.72) 0%,
				rgba(222, 199, 173, 0.28) 12%,
				rgba(119, 115, 97, 0.08) 28%,
				rgba(109, 104, 83, 0.06) 100%
			);
	}


	.location__ornament {
		position:
			absolute;

		z-index:
			-1;

		border:
			1px solid
			rgba(
				254,
				252,
				248,
				0.14
			);

		border-radius:
			50%;
	}


	.location__ornament--one {
		top:
			-10rem;

		left:
			-10rem;

		width:
			24rem;

		height:
			24rem;
	}


	.location__ornament--two {
		right:
			-12rem;

		bottom:
			-13rem;

		width:
			28rem;

		height:
			28rem;
	}


	.location__card {
		width:
			min(
				100%,
				42rem
			);

		margin:
			0 auto;

		padding:
			2.5rem
			1.4rem;

		border:
			1px solid
			rgba(
				254,
				252,
				248,
				0.25
			);

		border-radius:
			2rem;

		background:
			linear-gradient(
				145deg,
				rgba(254, 252, 248, 0.045),
				rgba(109, 104, 83, 0.025)
			);

		border-color:
			rgba(
				254,
				252,
				248,
				0.2
			);

		color:
			var(--warm-white);

		-webkit-backdrop-filter:
			blur(5px);

		backdrop-filter:
			blur(5px);

		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.28),
			0 1rem 2.5rem rgba(40, 25, 10, 0.12);

		position: relative;
		z-index: 1;
	}


	.location__eyebrow {
		color:
			var(--warm-white);

		font-size:
			0.62rem;

		letter-spacing:
			0.2em;

		text-transform:
			uppercase;
	}


	.location__pin {
		position:
			relative;

		width:
			6.5rem;

		height:
			6.5rem;

		margin:
			1.2rem
			auto;

		border:
			2px solid
			rgba(
				109,
				104,
				83,
				0.7
			);

		border-radius:
			50%;

		display:
			grid;

		place-items:
			center;

		background:
			rgba(
				109,
				104,
				83,
				0.25
			);

		-webkit-backdrop-filter:
			blur(12px);

		backdrop-filter:
			blur(12px);

		box-shadow:
			inset 0 1px 0
			rgba(
				254,
				252,
				248,
				0.3
			),

			0 0.5rem 1.5rem
			rgba(
				109,
				104,
				83,
				0.25
			);

		animation:
			location-float
			4s
			ease-in-out
			infinite;
	}


	.location__pin-ring {
		position:
			absolute;

		inset:
			-0.5rem;

		border:
			1px solid
			rgba(
				109,
				104,
				83,
				0.3
			);

		border-radius:
			50%;
	}


	.location__pin svg {
		width:
			1.6rem;

		fill:
			none;

		stroke:
			var(--olive-gray);

		stroke-width:
			1.4;
	}


	.location__heading > span {
		display:
			block;

		color:
			var(--ivory);

		font-size:
			clamp(
				0.5rem,
				1.8vw,
				0.75rem
			);

		letter-spacing:
			0.35em;

		text-transform:
			uppercase;

		font-weight: 600;
	}


	.location__heading h2 {
		margin:
			1rem 0 0;

		color:
			var(--warm-white);

		font-family:
			Georgia,
			'Times New Roman',
			serif;

		font-size:
			clamp(
				1.8rem,
				14vw,
				6.5rem
			);

		font-weight: 400;
		font-style: italic;

		line-height: 1.15;

		text-shadow:
			0 2px 8px rgba(40, 25, 10, 0.42);
	}

	.location__heading h2 small {
		display: block;
		margin-bottom: 0.15rem;
		color: var(--ivory);
		font-family:
			'Cormorant Garamond',
			serif;
		font-size: 0.44em;
		font-style: normal;
		font-weight: 600;
		letter-spacing: 0.2em;
		line-height: 1;
		text-transform: uppercase;
	}

	.location__heading h2 strong {
		display: block;
		color: var(--warm-white);
		font-family:
			Georgia,
			'Times New Roman',
			serif;
		font-size: 1em;
		font-style: italic;
		font-weight: 400;
	}


	.location__heading p {
		margin: 0.8rem 0 0;

		color:
			var(--warm-white);

		font-family:
			'Cormorant Garamond',
			serif;

		font-size:
			clamp(
				1rem,
				3vw,
				1.35rem
			);

		line-height: 1.5;

		font-weight: 500;
	}


	.location__divider {
		width:
			10rem;

		margin:
			1.5rem auto;

		display:
			grid;

		grid-template-columns:
			1fr auto 1fr;

		align-items:
			center;

		gap:
			0.6rem;
	}


	.location__divider span {
		height:
			1px;

		background:
			var(--champagne);
	}


	.location__divider small {
		color:
			var(--champagne);
	}


	.location__actions {
		display:
			flex;

		flex-wrap:
			wrap;

		justify-content:
			center;

		gap:
			0.75rem;
	}


	.location-button {
		min-width:
			9rem;
	}


	.location-button--primary {
		background:
			var(--olive-gray);

		color:
			var(--warm-white);
	}


	/* =====================================================
	   VESTIMENTA
	===================================================== */

	.dress-code {
		background:
			linear-gradient(
				180deg,
				#e3d0bd 0%,
				#c7b39f 10%,
				#d8cbbb 28%,
				#d8cbbb 52%,
				#f2eee7 100%
			);
	}


	.dress-code__card {
		width:
			min(
				100%,
				35rem
			);

		margin:
			0 auto;

		padding:
			2.4rem
			1.5rem;

		border:
			1px solid
			var(--champagne);

		border-radius:
			1.3rem;

		background:
			var(--warm-white);

		box-shadow:
			0.7rem
			0.7rem
			0
			var(--ivory);

		text-align:
			center;
	}


	.dress-code__icon {
		color:
			var(--honey);
	}


	.dress-code__card strong {
		display:
			block;

		margin-top:
			0.8rem;

		color:
			var(--espresso);
	}


	.dress-code__card p {
		color:
			var(--brown);

		line-height:
			1.7;
	}


	.dress-code__card small {
		color:
			var(--olive);
	}


	.dress-code__colors {
		margin-top:
			1.5rem;

		display:
			flex;

		justify-content:
			center;

		gap:
			0.55rem;
	}


	.dress-code__colors span {
		width:
			2rem;

		height:
			2rem;

		border:
			2px solid
			var(--warm-white);

		border-radius:
			50%;

		background:
			var(--color);

		box-shadow:
			0 0 0 1px
			var(--champagne);
	}


	/* =====================================================
	   AVISOS - NUEVO DISEÑO
	===================================================== */

	.notices {
		isolation:
			isolate;

		background:
			linear-gradient(
				180deg,
				#f2eee7 0%,
				#ede7de 24%,
				#e3d6c6 52%,
				#f5eee5 68%,
				#c5b6a8 100%
			);

		color:
			var(--espresso);
	}


	.notices::before {
		position:
			absolute;

		z-index:
			-2;

		inset:
			0;

		content:
			'';

		background:
			radial-gradient(
				circle at 90% 8%,
				rgba(
					109,
