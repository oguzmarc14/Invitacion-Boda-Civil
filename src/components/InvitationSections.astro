		display:
			block;
	}


	.rsvp-form label > span {
		margin-bottom:
			0.5rem;

		display:
			block;

		color:
			var(--espresso);

		font-size:
			0.6rem;

		font-weight:
			700;

		letter-spacing:
			0.13em;

		text-transform:
			uppercase;
	}


	.rsvp-form input,
	.rsvp-form select,
	.rsvp-form textarea {
		width:
