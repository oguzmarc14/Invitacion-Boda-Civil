	/* =====================================================
	   FOOTER
	===================================================== */

	.closing {
		position:
			relative;

		min-height:
			82svh;

		overflow:
			hidden;

		display:
			grid;

		place-items:
			center;

		color:
			var(--warm-white);

		text-align:
			center;
	}


	.closing > img,
	.closing__overlay {
		position:
			absolute;

		inset:
			0;

		width:
			100%;

		height:
			100%;
	}


	.closing > img {
		object-fit:
			cover;
	}


	.closing__overlay {
		background:
			linear-gradient(
				rgba(
					40,
					25,
					10,
					0.38
				),

				rgba(
					40,
					25,
					10,
					0.9
				)
			);
	}


	.closing__content {
		position:
			relative;

		z-index:
			1;

		width:
			min(
				88%,
				38rem
			);

		padding:
			2.5rem
			1.5rem;

		border:
			1px solid
			rgba(
				254,
				252,
				248,
				0.45
			);
	}


	.closing__content h2 {
		font-family:
			'Parisienne',
			cursive;

		font-size:
			clamp(
				3.5rem,
				15vw,
				7rem
			);

		font-weight:
			400;
	}

	.closing__names {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		margin: 0;
	}

	.closing__name-line {
		display: block;
		white-space: nowrap;
	}

	.closing__ampersand {
		display: block;
		font-size: 0.8em;
		line-height: 1;
		color: var(--honey);
		margin: 0.2rem 0;
	}


	/* =====================================================
	   REVEALS
	===================================================== */

	[data-reveal-child] {
		opacity:
			0;

		transform:
			translateY(
				2rem
			);

		transition:
			opacity 900ms ease,
			transform 1000ms
			cubic-bezier(
				0.22,
				1,
				0.36,
				1
			);
	}


	.is-revealed
	[data-reveal-child] {
		opacity:
			1;

		transform:
			translateY(0);
	}


	.is-revealed
	[data-reveal-gallery] {
		animation:
			reveal-up
			900ms
			var(--gallery-delay)
			both;
	}


	.is-revealed
	[data-reveal-timeline] {
		animation:
			reveal-left
			850ms
			var(--timeline-delay)
			both;
	}


	.is-revealed
	[data-reveal-notice] {
		animation:
			reveal-up
			850ms
			var(--notice-delay)
			both;
	}


	@keyframes reveal-up {
		from {
			opacity:
				0;

			transform:
				translateY(
					1.5rem
				);
		}

		to {
			opacity:
				1;

			transform:
				translateY(0);
		}
	}


	@keyframes reveal-left {
		from {
			opacity:
				0;

			transform:
				translateX(
					-1rem
				);
		}

		to {
			opacity:
				1;

			transform:
				translateX(0);
		}
	}


	@keyframes location-float {
		0%,
		100% {
			transform:
				translateY(0);
		}

		50% {
			transform:
				translateY(
					-0.4rem
				);
		}
	}


	/* =====================================================
	   DESKTOP
	===================================================== */

	@media (min-width: 768px) {
		.section-nav {
			justify-content:
				center;
		}


		.story,
		.gifts {
			grid-template-columns:
				repeat(
					2,
					minmax(
						0,
						1fr
					)
				);

			padding-inline:
				clamp(
					3rem,
					8vw,
					8rem
				);
		}


		.event-countdown {
			grid-template-columns:
				repeat(
					4,
					1fr
				);
		}


		.event__summary {
			grid-template-columns:
				repeat(
					3,
					1fr
				);
		}


		.event__summary > div + div {
			border-top: 0;

			border-left:
				1px solid
				var(--champagne);
		}


		.gallery__grid {
			grid-template-columns:
				1.4fr
				1fr
				1fr;
		}


		.gallery__item,
		.gallery__item--featured {
			grid-column:
				auto;

			height:
				34rem;
		}


		.notices__grid {
			grid-template-columns:
				repeat(
					3,
					1fr
				);
		}
	}


	/* =====================================================
	   MÓVIL
	===================================================== */

	@media (max-width: 390px) {
		.story__signature {
			gap:
				0.25rem;
		}


		.story__signature > span {
			font-size:
				2.35rem;
		}


		.notices__grid article {
			padding:
				1.6rem
				1.4rem;
		}


		.location__actions {
			flex-direction:
				column;
		}


		.location-button {
			width:
				100%;
		}
	}


	/* =====================================================
