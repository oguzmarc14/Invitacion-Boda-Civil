			aria-hidden="true"
		>
			<div class="location__pin-ring"></div>

			<svg viewBox="0 0 24 24">
				<path
					d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
				></path>

