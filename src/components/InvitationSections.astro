		</div>

		<div
			class="location__divider"
			aria-hidden="true"
		>
			<span></span>
			<small>✦</small>
			<span></span>
		</div>

		<div class="location__actions">
			<a
				class="
					button
					location-button
					location-button--primary
				"
				href={evento.mapsUrl}
				target="_blank"
				rel="noreferrer"
			>
				Google Maps
			</a>
		</div>
	</div>
</section>


<!-- =====================================================
     VESTIMENTA
===================================================== -->

<section
	class="section dress-code"
	id="vestimenta"
	data-reveal
>
