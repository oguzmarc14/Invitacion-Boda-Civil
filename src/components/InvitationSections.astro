	></div>

	<div
		class="section-heading notices__heading"
		data-reveal-child
	>
		<span>
			Información importante
		</span>

		<h2>
			Antes de acompañarnos
		</h2>

		<div
			class="heading-ornament heading-ornament--notices"
			aria-hidden="true"
