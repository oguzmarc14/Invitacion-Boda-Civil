</section>


<!-- =====================================================
     RSVP
===================================================== -->

<section
	class="section rsvp"
	id="confirmacion"
	data-reveal
>
	<div
		class="section-heading"
		data-reveal-child
	>
		<span>
			Queremos contar contigo
		</span>

		<h2>
			Confirma tu asistencia
		</h2>

		<p>
			Por favor confirma antes del
			{rsvp.fechaLimite}.
		</p>
	</div>

	<form
		class="rsvp-form"
		data-rsvp-form
		data-phone={rsvp.whatsapp}
		data-reveal-child
	>
		<label>
			<span>
				Nombre completo
			</span>

			<input
				type="text"
				name="name"
				autocomplete="name"
				required
				placeholder="Escribe tu nombre"
			/>
		</label>

		<label>
			<span>
				¿Nos acompañas?
			</span>

			<select
				name="attendance"
				required
			>
				<option
					value=""
					selected
					disabled
				>
					Selecciona una opción
				</option>

				<option value="Sí, asistiré">
					Sí, asistiré
				</option>

				<option value="No podré asistir">
					No podré asistir
				</option>
			</select>
		</label>

		<label>
			<span>
				Acompañantes
			</span>

			<select name="guests">
				{
					guestOptions.map((cantidad) => (
						<option value={cantidad}>
							{cantidad}
						</option>
					))
				}
			</select>
		</label>

		<label>
			<span>
				Mensaje o restricción alimentaria
			</span>

			<textarea
				name="message"
				rows="3"
				placeholder="Opcional"
			></textarea>
		</label>

		<button
			class="
				button
				button--olive
				rsvp-form__submit
			"
			type="submit"
		>
			Confirmar por WhatsApp
		</button>
	</form>
</section>


<!-- =====================================================
     CIERRE
===================================================== -->

<footer
	class="closing"
	data-reveal
>
	<img
		src={imagenes.portada}
		alt=""
		loading="lazy"
		aria-hidden="true"
	/>

	<div class="closing__overlay"></div>

	<div
		class="closing__content"
		data-reveal-child
	>
		<span>
			Gracias por ser parte de nuestra historia
		</span>

		<h2 class="closing__names">
			<div class="closing__name-line">{pareja.novio}</div>
			<small class="closing__ampersand">&amp;</small>
			<div class="closing__name-line">{pareja.novia}</div>
		</h2>

		<p>
			{textos.cierre}
		</p>

		<time datetime={evento.inicio}>
			{evento.fechaLarga}
		</time>
	</div>
</footer>


<script>
	const countdown =
		document.querySelector<HTMLElement>(
			'[data-event-countdown]'
		);

	const eventDate =
		countdown?.dataset.eventDate;

	const targetDate =
		eventDate
			? new Date(eventDate).getTime()
			: Date.now();

	const twoDigits =
		(value: number) =>
			String(value).padStart(2, '0');

	const updateEventCountdown = () => {
		const remaining =
			Math.max(
				0,
				targetDate - Date.now()
			);

		const values = {
			'[data-event-days]':
				String(
					Math.floor(
						remaining / 86_400_000
					)
				),

			'[data-event-hours]':
				twoDigits(
					Math.floor(
						(remaining / 3_600_000) % 24
					)
				),

			'[data-event-minutes]':
				twoDigits(
					Math.floor(
						(remaining / 60_000) % 60
					)
				),

			'[data-event-seconds]':
				twoDigits(
					Math.floor(
						(remaining / 1_000) % 60
					)
				),
		};

		Object.entries(values).forEach(
			([selector, value]) => {
				const element =
					countdown
						?.querySelector<HTMLElement>(
							selector
						);

				if (element) {
					element.textContent =
						value;
				}
			}
		);
	};

	updateEventCountdown();

	const countdownInterval =
		window.setInterval(
			updateEventCountdown,
			1000
		);


	const rsvpForm =
		document.querySelector<HTMLFormElement>(
			'[data-rsvp-form]'
		);

	rsvpForm?.addEventListener(
		'submit',
		(event) => {
			event.preventDefault();

			const formData =
				new FormData(rsvpForm);

			const phone =
				rsvpForm.dataset.phone ?? '';

			const message = [
				'Hola, quiero confirmar mi asistencia a la boda.',

				`Nombre: ${
					formData.get('name') ?? ''
				}`,

				`Asistencia: ${
					formData.get('attendance') ?? ''
				}`,

				`Acompañantes: ${
					formData.get('guests') ?? '0'
				}`,

				`Mensaje: ${
					formData.get('message') ||
					'Sin comentarios'
				}`,
			].join('\n');

			window.open(
				`https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
				'_blank',
				'noopener,noreferrer'
			);
		}
	);


	const revealSections =
		document.querySelectorAll<HTMLElement>(
			'[data-reveal]'
		);

	const observer =
		new IntersectionObserver(
			(entries) => {
				entries.forEach(
					(entry) => {
						if (!entry.isIntersecting) {
							return;
						}

						entry.target.classList.add(
							'is-revealed'
						);

						observer.unobserve(
							entry.target
						);
					}
				);
			},
			{
				threshold: 0.12,
				rootMargin:
					'0px 0px -5% 0px',
			}
		);

	revealSections.forEach(
		(section) => {
			observer.observe(section);
		}
	);


	document.addEventListener(
