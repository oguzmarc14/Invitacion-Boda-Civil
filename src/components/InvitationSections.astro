		top: 1.2rem;
		left: 1.2rem;
		width: 4rem;
		height: 4rem;
		border-top: 1px solid rgba(109, 104, 83, 0.35);
		border-left: 1px solid rgba(109, 104, 83, 0.35);
		border-radius: 1.2rem 0 0;
		content: '';
		pointer-events: none;
