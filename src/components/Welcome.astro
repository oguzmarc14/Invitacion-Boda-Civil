---
interface Props {
	novia: string;
	novio: string;
	fecha: string;
	fechaObjetivo: string;
	imagen: string;
}

const {
	novia,
	novio,
	fecha,
	fechaObjetivo,
	imagen,
} = Astro.props;
---

<section
	class="welcome-screen"
	data-welcome
>
	<img
		class="welcome-screen__photo"
		src={imagen}
		alt={`Fotografía de ${novio} y ${novia}`}
		loading="eager"
		fetchpriority="high"
	/>

	<div class="welcome-screen__veil"></div>

	<div class="welcome-photo-caption" aria-label="Estos niños se casan">
		<span>Estos niños</span>
		<span>se casan!</span>
		<small aria-hidden="true">♡</small>
	</div>

	<div
		class="welcome-screen__glass"
		aria-hidden="true"
	></div>

	<div
		class="welcome-screen__aura welcome-screen__aura--champagne"
		aria-hidden="true"
	></div>

	<div
		class="welcome-screen__aura welcome-screen__aura--olive"
		aria-hidden="true"
	></div>

	<div class="welcome-screen__content">
		

		<div class="couple-card">
			<h1>
				{novio} &amp; {novia}
			</h1>

			<div class="couple-card__date">
				<span aria-hidden="true">•</span>

				<time datetime={fechaObjetivo}>
					{fecha}
				</time>

				<span aria-hidden="true">•</span>

				<span>
					Nuestra boda
				</span>

				<span aria-hidden="true">•</span>
			</div>
		</div>

		<div class="welcome-message">
			<span class="welcome-message__eyebrow">
				Con mucha ilusión
			</span>

			<p>
				Queremos compartir contigo
				el comienzo de esta nueva etapa
				de nuestras vidas.
			</p>

			<div
				class="welcome-message__ornament"
				aria-hidden="true"
			>
				<span></span>

				<small>✦</small>

				<span></span>
			</div>

			<strong>
				Nos casamos
			</strong>
		</div>

		<button
			class="open-invitation"
			type="button"
			data-open-invitation
		>
			<span
				class="open-invitation__icon"
				aria-hidden="true"
			>
				<svg viewBox="0 0 24 24">
					<path d="m9 7 8 5-8 5V7Z"></path>
				</svg>
			</span>

			<span>
				Abrir invitación
			</span>
		</button>

	</div>
</section>

<script>
	const welcome =
		document.querySelector<HTMLElement>(
			'[data-welcome]'
		);

	const openButton =
		welcome?.querySelector<HTMLButtonElement>(
			'[data-open-invitation]'
		);

	openButton?.addEventListener(
		'click',
		() => {
			document.body.classList.add(
				'invitation-open'
			);

			welcome?.classList.add(
				'is-leaving'
			);

			document
				.querySelector<HTMLElement>(
					'[data-invitation-content]'
				)
				?.classList.add(
					'is-visible'
				);

			window.dispatchEvent(
				new CustomEvent(
					'invitation:open'
				)
			);

			window.setTimeout(
				() => {
					welcome?.remove();
				},
				950
			);
		}
	);
</script>

