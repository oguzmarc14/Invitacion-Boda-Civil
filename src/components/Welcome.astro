---
interface Props {
	novia: string;
	novio: string;
	fecha: string;
	fechaObjetivo: string;
	imagen: string;
	tieneMusica?: boolean;
}

const {
	novia,
	novio,
	fecha,
	fechaObjetivo,
	imagen,
	tieneMusica = false,
} = Astro.props;
---

<section
	class="welcome-screen"
	data-welcome
	data-event-date={fechaObjetivo}
>
	<img
		class="welcome-screen__photo"
		src={imagen}
		alt={`Fotografía de ${novio} y ${novia}`}
		loading="eager"
		fetchpriority="high"
	/>

	<div class="welcome-screen__veil"></div>
	<div class="welcome-screen__glass" aria-hidden="true"></div>
	<div class="welcome-screen__aura welcome-screen__aura--champagne" aria-hidden="true"></div>
	<div class="welcome-screen__aura welcome-screen__aura--olive" aria-hidden="true"></div>

	<div class="welcome-screen__content">
		<svg
			class="botanical-ornament"
			viewBox="0 0 190 82"
			aria-hidden="true"
		>
			<path d="M20 68C58 64 75 42 101 17"></path>
			<path d="M92 27C112 27 135 38 167 56"></path>
			<path d="M65 53c-4-13 1-22 15-27-1 14-5 22-15 27Z"></path>
			<path d="M45 63c-7-10-5-19 7-28 3 12 1 21-7 28Z"></path>
			<path d="M80 42c8-12 17-15 29-9-8 10-17 13-29 9Z"></path>
			<path d="M105 29c2-14 10-20 24-20-3 13-11 19-24 20Z"></path>
			<path d="M118 32c12-7 22-5 30 6-12 4-22 2-30-6Z"></path>
			<path d="M137 42c13-5 22-1 28 11-13 2-22-2-28-11Z"></path>
			<path d="M34 66c-9 2-15 8-17 16"></path>
			<circle cx="98" cy="21" r="2.4"></circle>
			<circle cx="104" cy="16" r="1.8"></circle>
			<circle cx="111" cy="12" r="1.5"></circle>
			<circle cx="153" cy="49" r="2"></circle>
		</svg>

		<div class="couple-card">
			<h1>{novio} &amp; {novia}</h1>

			<div class="couple-card__date">
				<span aria-hidden="true">•</span>
				<time datetime={fechaObjetivo}>{fecha}</time>
				<span aria-hidden="true">•</span>
				<span>Nuestra boda</span>
				<span aria-hidden="true">•</span>
			</div>
		</div>

		<div class="countdown" aria-label="Cuenta regresiva para la boda">
			<div>
				<strong data-days>000</strong>
				<span>Días</span>
			</div>
			<div>
				<strong data-hours>00</strong>
				<span>Horas</span>
			</div>
			<div>
				<strong data-minutes>00</strong>
				<span>Minutos</span>
			</div>
			<div>
				<strong data-seconds>00</strong>
				<span>Segundos</span>
			</div>
		</div>

		<button class="open-invitation" type="button" data-open-invitation>
			<span class="open-invitation__icon" aria-hidden="true">
				<svg viewBox="0 0 24 24">
					<path d="m9 7 8 5-8 5V7Z"></path>
				</svg>
			</span>
			<span>Abrir invitación</span>
		</button>

		{
			tieneMusica && (
				<p class="music-hint">Esta invitación contiene música</p>
			)
		}
	</div>
</section>

<script>
	const welcome = document.querySelector<HTMLElement>('[data-welcome]');
	const openButton = welcome?.querySelector<HTMLButtonElement>('[data-open-invitation]');
	const daysElement = welcome?.querySelector<HTMLElement>('[data-days]');
	const hoursElement = welcome?.querySelector<HTMLElement>('[data-hours]');
	const minutesElement = welcome?.querySelector<HTMLElement>('[data-minutes]');
	const secondsElement = welcome?.querySelector<HTMLElement>('[data-seconds]');
	const eventDate = welcome?.dataset.eventDate;
	const targetDate = eventDate ? new Date(eventDate).getTime() : Date.now();
	const twoDigits = (value: number) => String(value).padStart(2, '0');

	const updateCountdown = () => {
		const remaining = Math.max(0, targetDate - Date.now());
		const days = Math.floor(remaining / 86_400_000);
		const hours = Math.floor((remaining / 3_600_000) % 24);
		const minutes = Math.floor((remaining / 60_000) % 60);
		const seconds = Math.floor((remaining / 1_000) % 60);

		if (daysElement) daysElement.textContent = String(days);
		if (hoursElement) hoursElement.textContent = twoDigits(hours);
		if (minutesElement) minutesElement.textContent = twoDigits(minutes);
		if (secondsElement) secondsElement.textContent = twoDigits(seconds);
	};

	updateCountdown();
	const countdownInterval = window.setInterval(updateCountdown, 1000);

	openButton?.addEventListener('click', () => {
		document.body.classList.add('invitation-open');
		welcome?.classList.add('is-leaving');
		document
			.querySelector<HTMLElement>('[data-invitation-content]')
			?.classList.add('is-visible');
		window.dispatchEvent(new CustomEvent('invitation:open'));

		window.setTimeout(() => {
			window.clearInterval(countdownInterval);
			welcome?.remove();
		}, 950);
	});
</script>

<style>
	:global(body:not(.invitation-open)) {
		overflow: hidden;
	}

	.welcome-screen {
		position: fixed;
		z-index: 100;
		inset: 0;
		min-height: 100svh;
		overflow: hidden;
		background: #28190a;
		color: #fefcf8;
		opacity: 1;
		transform: scale(1);
		transition:
			opacity 750ms ease,
			transform 950ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 750ms ease;
	}

	.welcome-screen.is-leaving {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: scale(1.035);
	}

	.welcome-screen__photo,
	.welcome-screen__veil,
	.welcome-screen__glass {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.welcome-screen__photo {
		display: block;
		object-fit: cover;
		object-position: 50% 45%;
		filter: saturate(0.82) contrast(0.93);
		transform: scale(1.01);
		animation: photo-breathe 18s ease-in-out infinite alternate;
	}

	.welcome-screen__veil {
		background:
			radial-gradient(circle at 76% 18%, rgba(222, 199, 173, 0.18), transparent 30%),
			linear-gradient(
				180deg,
				rgba(40, 25, 10, 0.03) 20%,
				rgba(40, 25, 10, 0.14) 47%,
				rgba(40, 25, 10, 0.84) 100%
			),
			linear-gradient(90deg, rgba(109, 104, 83, 0.08), rgba(112, 76, 50, 0.12));
	}

	.welcome-screen__glass {
		overflow: hidden;
		background: linear-gradient(
			125deg,
			rgba(254, 252, 248, 0.14) 0%,
			transparent 28%,
			rgba(222, 199, 173, 0.035) 58%,
			rgba(236, 228, 217, 0.11) 100%
		);
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.34),
			inset 1px 0 0 rgba(254, 252, 248, 0.16),
			inset 0 -1px 0 rgba(40, 25, 10, 0.22);
		-webkit-backdrop-filter: blur(0.8px) saturate(108%);
		backdrop-filter: blur(0.8px) saturate(108%);
		pointer-events: none;
	}

	.welcome-screen__glass::before {
		position: absolute;
		top: -18%;
		left: -42%;
		width: 32%;
		height: 140%;
		content: '';
		background: linear-gradient(
			90deg,
			transparent,
			rgba(254, 252, 248, 0.12),
			rgba(254, 252, 248, 0.28),
			rgba(222, 199, 173, 0.08),
			transparent
		);
		filter: blur(5px);
		transform: skewX(-18deg);
		animation: photo-glass-shine 7s ease-in-out infinite;
	}

	.welcome-screen__glass::after {
		position: absolute;
		inset: 0.7rem;
		content: '';
		border: 1px solid rgba(254, 252, 248, 0.11);
		border-radius: 1.2rem;
		box-shadow: inset 0 0 2rem rgba(222, 199, 173, 0.04);
	}

	.welcome-screen__aura {
		position: absolute;
		border-radius: 50%;
		filter: blur(54px);
		pointer-events: none;
	}

	.welcome-screen__aura--champagne {
		top: 8%;
		right: -7rem;
		width: 18rem;
		height: 18rem;
		background: rgba(222, 199, 173, 0.2);
	}

	.welcome-screen__aura--olive {
		bottom: 10%;
		left: -8rem;
		width: 20rem;
		height: 20rem;
		background: rgba(109, 104, 83, 0.2);
	}

	.welcome-screen__content {
		position: absolute;
		z-index: 2;
		right: 50%;
		bottom: max(1.4rem, env(safe-area-inset-bottom));
		width: min(88vw, 29rem);
		padding: clamp(1rem, 2.7vh, 1.45rem) clamp(0.85rem, 3.8vw, 1.35rem);
		overflow: hidden;
		isolation: isolate;
		border: 1px solid rgba(254, 252, 248, 0.22);
		border-radius: 1.65rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		background: linear-gradient(
			145deg,
			rgba(254, 252, 248, 0.1),
			rgba(236, 228, 217, 0.035) 46%,
			rgba(109, 104, 83, 0.08)
		);
		color: #fefcf8;
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.3),
			inset 0 -1px 0 rgba(222, 199, 173, 0.1),
			0 1.25rem 3.2rem rgba(40, 25, 10, 0.22);
		text-align: center;
		transform: translateX(50%);
		-webkit-backdrop-filter: blur(8px) saturate(108%);
		backdrop-filter: blur(8px) saturate(108%);
	}

	.welcome-screen__content::before {
		position: absolute;
		z-index: -2;
		inset: 0;
		content: '';
		background:
			radial-gradient(circle at 15% 0%, rgba(254, 252, 248, 0.1), transparent 34%),
			linear-gradient(115deg, rgba(198, 156, 112, 0.035), transparent 48%);
		pointer-events: none;
	}

	.botanical-ornament {
		width: clamp(7.8rem, 38vw, 11rem);
		height: auto;
		margin-bottom: clamp(0.45rem, 1.3vh, 0.85rem);
		overflow: visible;
		fill: #fefcf8;
		stroke: #fefcf8;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		filter: drop-shadow(0 0 0.65rem rgba(222, 199, 173, 0.34));
	}

	.couple-card {
		position: relative;
		width: 100%;
		padding: clamp(0.8rem, 2.1vh, 1.05rem) 0.8rem clamp(0.7rem, 1.8vh, 0.9rem);
		border: 1px solid rgba(254, 252, 248, 0.82);
		background: linear-gradient(110deg, rgba(40, 25, 10, 0.1), rgba(254, 252, 248, 0.05));
		box-shadow:
			inset 0 0 0 1px rgba(222, 199, 173, 0.08),
			0 0 1.3rem rgba(222, 199, 173, 0.08);
	}

	.couple-card h1 {
		margin: 0;
		color: #fefcf8;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.18rem, 5.7vw, 2rem);
		font-weight: 400;
		letter-spacing: clamp(0.12em, 0.8vw, 0.2em);
		line-height: 1.15;
		text-transform: uppercase;
		text-shadow: 0 2px 12px rgba(40, 25, 10, 0.45);
		white-space: nowrap;
	}

	.couple-card__date {
		margin-top: clamp(0.55rem, 1.25vh, 0.8rem);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		font-size: clamp(0.48rem, 2vw, 0.63rem);
		letter-spacing: 0.17em;
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.countdown {
		width: min(94%, 25rem);
		margin-top: clamp(1.3rem, 3.2vh, 2rem);
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		column-gap: clamp(0.55rem, 3.5vw, 1.4rem);
	}

	.countdown div {
		position: relative;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.countdown div + div::before {
		position: absolute;
		top: 0.15rem;
		bottom: 0.05rem;
		left: calc(clamp(0.55rem, 3.5vw, 1.4rem) / -2);
		width: 1px;
		content: '';
		background: linear-gradient(transparent, rgba(222, 199, 173, 0.46), transparent);
	}

	.countdown strong {
		color: #fefcf8;
		font-size: clamp(1.55rem, 7vw, 2.2rem);
		font-weight: 400;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		text-shadow: 0 2px 11px rgba(40, 25, 10, 0.5);
	}

	.countdown span {
		margin-top: 0.45rem;
		font-size: clamp(0.42rem, 1.8vw, 0.58rem);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.open-invitation {
		position: relative;
		min-width: min(15rem, 78vw);
		min-height: 3rem;
		margin-top: clamp(1.25rem, 3vh, 1.85rem);
		padding: 0.72rem 1.5rem;
		border: 1px solid #dec7ad;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		overflow: hidden;
		background: rgba(109, 104, 83, 0.9);
		color: #fefcf8;
		box-shadow: 0 0.8rem 2rem rgba(40, 25, 10, 0.28);
		font-size: 0.68rem;
		letter-spacing: 0.19em;
		text-transform: uppercase;
		cursor: pointer;
		backdrop-filter: blur(8px);
		transition:
			background-color 250ms ease,
			border-color 250ms ease,
			box-shadow 250ms ease,
			color 250ms ease,
			letter-spacing 250ms ease,
			transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.open-invitation > span {
		position: relative;
		z-index: 1;
	}

	.open-invitation:focus-visible {
		outline: 2px solid #fefcf8;
		outline-offset: 4px;
	}

	.open-invitation__icon {
		width: 1.25rem;
		height: 1.25rem;
		border: 1px solid rgba(254, 252, 248, 0.62);
		border-radius: 50%;
		display: grid;
		place-items: center;
		transition:
			background-color 250ms ease,
			border-color 250ms ease,
			transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.open-invitation__icon svg {
		width: 0.72rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
		transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.open-invitation:active {
		transform: translateY(1px) scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.open-invitation:hover {
			border-color: #fefcf8;
			background: #dec7ad;
			color: #28190a;
			box-shadow:
				0 0 0 4px rgba(222, 199, 173, 0.18),
				0 1.1rem 2.4rem rgba(40, 25, 10, 0.38),
				0 0 1.7rem rgba(222, 199, 173, 0.48);
			letter-spacing: 0.215em;
			transform: translateY(-4px) scale(1.045);
		}

		.open-invitation:hover .open-invitation__icon {
			border-color: #704c32;
			background: rgba(254, 252, 248, 0.44);
			transform: scale(1.14) rotate(-6deg);
		}

		.open-invitation:hover .open-invitation__icon svg {
			transform: translateX(1px) scale(1.08);
		}
	}

	@media (hover: none), (pointer: coarse) {
		.open-invitation {
			transform-origin: center;
			animation: mobile-button-breathe 2.2s ease-in-out infinite;
		}

		.open-invitation:active {
			animation: none;
			transform: scale(0.96);
		}
	}

	.music-hint {
		margin: 0.65rem 0 0;
		color: rgba(254, 252, 248, 0.76);
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.54rem;
		letter-spacing: 0.1em;
	}

	@keyframes mobile-button-breathe {
		0%, 100% {
			box-shadow: 0 0.8rem 2rem rgba(40, 25, 10, 0.28);
			transform: scale(1);
		}

		50% {
			box-shadow:
				0 0 0 3px rgba(222, 199, 173, 0.16),
				0 1rem 2.4rem rgba(40, 25, 10, 0.34);
			transform: scale(1.055);
		}
	}

	@keyframes photo-breathe {
		to {
			transform: scale(1.055);
		}
	}

	@keyframes photo-glass-shine {
		0%, 48% {
			left: -42%;
			opacity: 0;
		}

		55% {
			opacity: 0.72;
		}

		76%, 100% {
			left: 132%;
			opacity: 0;
		}
	}

	@media (min-width: 768px) {
		.welcome-screen__photo {
			object-position: center 42%;
		}

		.welcome-screen__content {
			bottom: clamp(2rem, 6vh, 4.75rem);
			width: min(84vw, 32rem);
		}

		.couple-card h1 {
			font-size: 2.15rem;
		}

		.countdown strong {
			font-size: 2.35rem;
		}
	}

	@media (max-height: 660px) {
		.welcome-screen__content {
			bottom: 0.8rem;
			width: min(84vw, 27rem);
			padding: 0.75rem 0.8rem;
		}

		.botanical-ornament {
			width: 7rem;
			margin-bottom: 0.3rem;
		}

		.couple-card {
			padding-block: 0.65rem;
		}

		.countdown {
			margin-top: 0.85rem;
		}

		.open-invitation {
			min-height: 2.65rem;
			margin-top: 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.welcome-screen__photo,
		.welcome-screen__glass::before,
		.open-invitation {
			animation: none;
		}

		.welcome-screen {
			transition-duration: 0.01ms;
		}
	}
</style>
