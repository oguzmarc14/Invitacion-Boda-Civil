---
interface Props {
	novia: string;
	novio: string;
	fecha: string;
	fechaObjetivo: string;
	titulo: string;
	mensajeInvitacion: string;
}

const {
	novia,
	novio,
	fecha,
	fechaObjetivo,
	titulo,
	mensajeInvitacion,
} = Astro.props;
---

<section class="home" data-invitation-content aria-labelledby="home-title">
	<div class="home__olive-shape" aria-hidden="true"></div>
	<div class="home__espresso-line" aria-hidden="true"></div>

	<svg class="home__leaves home__leaves--top" viewBox="0 0 180 210" aria-hidden="true">
		<path d="M24 198C54 142 78 86 138 18"></path>
		<path d="M52 146c-25-5-38-19-38-42 24 4 37 18 38 42Z"></path>
		<path d="M73 111c-2-24 9-40 32-48 1 23-10 39-32 48Z"></path>
		<path d="M95 79c14-19 31-25 52-17-14 18-31 24-52 17Z"></path>
		<path d="M112 52c0-20 10-34 29-41 1 20-9 34-29 41Z"></path>
	</svg>

	<svg class="home__leaves home__leaves--bottom" viewBox="0 0 180 210" aria-hidden="true">
		<path d="M24 198C54 142 78 86 138 18"></path>
		<path d="M52 146c-25-5-38-19-38-42 24 4 37 18 38 42Z"></path>
		<path d="M73 111c-2-24 9-40 32-48 1 23-10 39-32 48Z"></path>
		<path d="M95 79c14-19 31-25 52-17-14 18-31 24-52 17Z"></path>
		<path d="M112 52c0-20 10-34 29-41 1 20-9 34-29 41Z"></path>
	</svg>

	<div class="home__content">
		<header class="home__invitation">
			<span class="home__eyebrow">Con mucha alegría</span>
			<p>{mensajeInvitacion}</p>
		</header>

		<div class="home__divider" aria-hidden="true">
			<span></span>
			<svg viewBox="0 0 42 22">
				<path d="M2 19C12 16 18 10 24 2"></path>
				<path d="M16 11c-7 0-11-3-12-9 7 0 11 3 12 9Z"></path>
				<path d="M23 5c5-4 10-4 15 0-5 4-10 4-15 0Z"></path>
			</svg>
			<span></span>
		</div>

		<p class="home__title" id="home-title">{titulo}</p>

		<h1 class="home__names">
			<span>{novio}</span>
			<small>&amp;</small>
			<span>{novia}</span>
		</h1>

		<div class="home__date-card">
			<span>Reserva la fecha</span>
			<time datetime={fechaObjetivo}>{fecha}</time>
		</div>

		<p class="home__closing">Será un honor celebrar contigo.</p>
	</div>
</section>

<style>
	.home {
		position: relative;
		width: 100%;
		min-height: 100svh;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: #fefcf8;
		color: #28190a;
		opacity: 0;
		transform: translateY(1rem);
		transition:
			opacity 700ms ease 180ms,
			transform 900ms cubic-bezier(0.22, 1, 0.36, 1) 180ms;
	}

	.home.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.home__olive-shape {
		position: absolute;
		top: -9rem;
		right: -8rem;
		width: 21rem;
		height: 28rem;
		border-radius: 48% 0 52% 55%;
		background: #6d6853;
		transform: rotate(12deg);
	}

	.home__olive-shape::after {
		position: absolute;
		right: 5.5rem;
		bottom: -4.5rem;
		width: 9rem;
		height: 9rem;
		border: 1px solid rgba(254, 252, 248, 0.38);
		border-radius: 50%;
		content: '';
	}

	.home__espresso-line {
		position: absolute;
		right: 1.15rem;
		bottom: 0;
		width: 0.35rem;
		height: 28%;
		background: #28190a;
	}

	.home__leaves {
		position: absolute;
		width: 9rem;
		height: auto;
		fill: #ece4d9;
		stroke: #ece4d9;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.home__leaves--top {
		top: -1.6rem;
		left: -2.6rem;
		transform: rotate(22deg);
	}

	.home__leaves--bottom {
		right: -2.2rem;
		bottom: -2.8rem;
		transform: rotate(205deg);
	}

	.home__content {
		position: relative;
		z-index: 2;
		width: min(88%, 34rem);
		margin: 2rem auto;
		padding: clamp(2.3rem, 6vh, 3.6rem) clamp(1.25rem, 5vw, 2.5rem);
		border: 1px solid #ece4d9;
		background: rgba(254, 252, 248, 0.94);
		box-shadow:
			0.8rem 0.8rem 0 #ece4d9,
			0 1.6rem 4rem rgba(40, 25, 10, 0.09);
		text-align: center;
	}

	.home__content::before,
	.home__content::after {
		position: absolute;
		width: 2.7rem;
		height: 2.7rem;
		content: '';
		pointer-events: none;
	}

	.home__content::before {
		top: 0.65rem;
		left: 0.65rem;
		border-top: 2px solid #6d6853;
		border-left: 2px solid #6d6853;
	}

	.home__content::after {
		right: 0.65rem;
		bottom: 0.65rem;
		border-right: 2px solid #28190a;
		border-bottom: 2px solid #28190a;
	}

	.home__invitation {
		max-width: 27rem;
		margin: 0 auto;
	}

	.home__eyebrow {
		display: block;
		color: #6d6853;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	.home__invitation p {
		margin: 1rem 0 0;
		color: #28190a;
		font-size: clamp(0.9rem, 3.6vw, 1.05rem);
		line-height: 1.75;
	}

	.home__divider {
		width: min(13rem, 72%);
		margin: 1.6rem auto 1.25rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.home__divider > span {
		width: 100%;
		height: 1px;
		background: #6d6853;
		opacity: 0.55;
	}

	.home__divider svg {
		width: 2.5rem;
		flex: 0 0 auto;
		fill: #6d6853;
		stroke: #6d6853;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
	}

	.home__title {
		margin: 0;
		color: #6d6853;
		font-size: clamp(0.72rem, 2.8vw, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.36em;
		text-transform: uppercase;
	}

	.home__names {
		margin: clamp(1.1rem, 3vh, 1.7rem) 0;
		display: flex;
		flex-direction: column;
		color: #28190a;
		font-family: 'Parisienne', cursive;
		font-size: clamp(4rem, 18vw, 6.6rem);
		font-weight: 400;
		line-height: 0.76;
	}

	.home__names span {
		display: block;
		text-shadow: 0 0.45rem 1.4rem rgba(40, 25, 10, 0.08);
	}

	.home__names small {
		margin: 0.55rem 0 0.65rem;
		color: #6d6853;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.35em;
		font-weight: 400;
		line-height: 1;
	}

	.home__date-card {
		width: min(100%, 21rem);
		margin: 1.8rem auto 0;
		padding: 0.9rem 1rem 1rem;
		border: 1px solid #28190a;
		background: #6d6853;
		color: #fefcf8;
		box-shadow: 0.45rem 0.45rem 0 #28190a;
	}

	.home__date-card span,
	.home__date-card time {
		display: block;
	}

	.home__date-card span {
		color: #ece4d9;
		font-size: 0.53rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
	}

	.home__date-card time {
		margin-top: 0.55rem;
		font-size: clamp(0.88rem, 3.5vw, 1.05rem);
		letter-spacing: 0.2em;
	}

	.home__closing {
		margin: 1.45rem 0 0;
		color: #704c32;
		font-size: 0.78rem;
		font-style: italic;
	}

	@media (min-width: 768px) {
		.home__olive-shape {
			top: -16rem;
			right: -7rem;
			width: 38rem;
			height: 45rem;
		}

		.home__leaves {
			width: 14rem;
		}

		.home__content {
			width: min(76%, 48rem);
			padding-inline: 5rem;
		}

		.home__names {
			font-size: clamp(6rem, 9vw, 8.6rem);
		}
	}

	@media (max-height: 700px) {
		.home__content {
			margin-block: 1rem;
			padding-block: 1.7rem;
		}

		.home__divider {
			margin-block: 1rem 0.8rem;
		}

		.home__names {
			margin-block: 0.9rem;
			font-size: clamp(3.4rem, 15vw, 5rem);
		}

		.home__date-card {
			margin-top: 1.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home {
			transition-duration: 0.01ms;
		}
	}
</style>
