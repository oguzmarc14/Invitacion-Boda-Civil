---
interface Props {
	novia: string;
	novio: string;
	fecha: string;
	fechaObjetivo: string;
	titulo: string;
	mensajeInvitacion: string;
	imagen: string;
}

const {
	novia,
	novio,
	fecha,
	fechaObjetivo,
	titulo,
	mensajeInvitacion,
	imagen,
} = Astro.props;
---

<section
	class="home"
	data-invitation-content
	data-home-countdown
	data-event-date={fechaObjetivo}
	aria-labelledby="home-title"
>
	<img
		class="home__background"
		src={imagen}
		alt={`Fotografía de ${novia} y ${novio}`}
		loading="eager"
		fetchpriority="high"
	/>

	<div
		class="home__overlay"
		aria-hidden="true"
	></div>

	<div
		class="home__grain"
		aria-hidden="true"
	></div>

	<div class="home__content">

		<!-- =========================
			TÍTULO
		========================= -->

		<div class="home__intro">
			<span class="home__intro-line"></span>

			<p
				class="home__title"
				id="home-title"
			>
				{titulo}
			</p>

			<span class="home__intro-line"></span>
		</div>


		<!-- =========================
			NOMBRES
		========================= -->

		<h1 class="home__names">
			<span>{novia}</span>

			<small>&amp;</small>

			<span>{novio}</span>
		</h1>


		<!-- =========================
			FECHA
		========================= -->

		<div class="home__date">
			<span class="home__date-decoration">
				✦
			</span>

			<div>
				<time datetime={fechaObjetivo}>
					{fecha}
				</time>

			</div>

			<span class="home__date-decoration">
				✦
			</span>
		</div>


		<!-- =========================
			CONTADOR
		========================= -->

		<div class="home__countdown-area">

			<p class="home__faltan">
				Faltan
			</p>

			<div
				class="home__countdown"
				aria-label="Cuenta regresiva para la boda"
			>

				<div
					class="
						home__countdown-item
						home__countdown-item--champagne
					"
				>
					<strong data-home-days>
						000
					</strong>

					<span>
						Días
					</span>
				</div>

				<div
					class="
						home__countdown-item
						home__countdown-item--honey
					"
				>
					<strong data-home-hours>
						00
					</strong>

					<span>
						Horas
					</span>
				</div>

				<div
					class="
						home__countdown-item
						home__countdown-item--olive
					"
				>
					<strong data-home-minutes>
						00
					</strong>

					<span>
						Minutos
					</span>
				</div>

				<div
					class="
						home__countdown-item
						home__countdown-item--brown
					"
				>
					<strong data-home-seconds>
						00
					</strong>

					<span>
						Segundos
					</span>
				</div>

			</div>
		</div>


		<!-- =========================
			MENSAJE
		========================= -->

		<div class="home__message-area">
			<span aria-hidden="true">
				“
			</span>

			<p class="home__message">
				{mensajeInvitacion}
			</p>
		</div>


		<!-- =========================
			CONTINUAR
		========================= -->

		<a
			class="home__continue"
			href="#historia"
		>
			<span>
				Desliza para continuar
			</span>

			<svg
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path d="M6 9l6 6 6-6"></path>
			</svg>
		</a>

	</div>
</section>


<script>
	const home =
		document.querySelector<HTMLElement>(
			"[data-invitation-content]"
		);

	window.addEventListener(
		"invitation:open",
		() => {
			if (!home) return;

			window.setTimeout(
				() => {
					home.classList.add(
						"is-visible"
					);

					home.classList.add(
						"is-open"
					);
				},
				180
			);
		}
	);


	const countdown =
		document.querySelector<HTMLElement>(
			"[data-home-countdown]"
		);

	const eventDate =
		countdown?.dataset.eventDate;

	const targetDate =
		eventDate
			? new Date(
					eventDate
				).getTime()
			: Date.now();

	const twoDigits =
		(value: number) =>
			String(
				value
			).padStart(
				2,
				"0"
			);


	const updateCountdown = () => {
		const remaining =
			Math.max(
				0,
				targetDate -
					Date.now()
			);

		const days =
			Math.floor(
				remaining /
					86_400_000
			);

		const hours =
			Math.floor(
				(
					remaining /
					3_600_000
				) % 24
			);

		const minutes =
			Math.floor(
				(
					remaining /
					60_000
				) % 60
			);

		const seconds =
			Math.floor(
				(
					remaining /
					1_000
				) % 60
			);


		const values = {
			"[data-home-days]":
				String(days),

			"[data-home-hours]":
				twoDigits(hours),

			"[data-home-minutes]":
				twoDigits(minutes),

			"[data-home-seconds]":
				twoDigits(seconds),
		};


		Object
			.entries(values)
			.forEach(
				([
					selector,
					value
				]) => {

					const element =
						countdown
							?.querySelector<HTMLElement>(
								selector
							);

					if (element) {
						element.textContent =
							value;
					}
				}
			);
	};


	updateCountdown();


	const countdownInterval =
		window.setInterval(
			updateCountdown,
			1000
		);


	document.addEventListener(
		"astro:before-swap",

		() => {
			window.clearInterval(
				countdownInterval
			);
		},

		{
			once: true,
		}
	);
</script>


