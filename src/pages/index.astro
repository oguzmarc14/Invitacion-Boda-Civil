---
import Welcome from '../components/Welcome.astro';
import Home from '../components/Home.astro';
import InvitationSections from '../components/InvitationSections.astro';
import Layout from '../layouts/Layout.astro';
import { invitation } from '../data/invitation';
---

<Layout title={`${invitation.pareja.novio} & ${invitation.pareja.novia} | Nuestra boda`}>
	<Welcome
		novia={invitation.pareja.novia}
		novio={invitation.pareja.novio}
		fecha={invitation.evento.fechaCorta}
		fechaObjetivo={invitation.evento.inicio}
		imagen={invitation.imagenes.portada}
	/>

	<main>
		<Home
			novia={invitation.pareja.novia}
			imagen={invitation.imagenes.tematica}
			novio={invitation.pareja.novio}
			fecha={invitation.evento.fechaLarga}
			fechaObjetivo={invitation.evento.inicio}
			titulo={invitation.evento.titulo}
			mensajeInvitacion={invitation.textos.invitacion}
		/>

		<InvitationSections invitation={invitation} />
	</main>

	<audio id="wedding-music" src={invitation.musica.src} preload="auto" loop></audio>
	<button class="music-button" type="button" data-music-button aria-label="Pausar música">
		<span aria-hidden="true">♫</span>
	</button>
</Layout>

<script>
	const audio = document.querySelector<HTMLAudioElement>('#wedding-music');
	const musicButton = document.querySelector<HTMLButtonElement>('[data-music-button]');

	window.addEventListener('invitation:open', async () => {
		if (!audio) return;
		musicButton?.classList.add('is-visible');

		try {
			await audio.play();
		} catch {
			musicButton?.classList.add('is-paused');
		}
	});

	musicButton?.addEventListener('click', async () => {
		if (!audio) return;

		if (audio.paused) {
			await audio.play();
			musicButton.classList.remove('is-paused');
			musicButton.setAttribute('aria-label', 'Pausar música');
		} else {
			audio.pause();
			musicButton.classList.add('is-paused');
			musicButton.setAttribute('aria-label', 'Reproducir música');
		}
	});

	/*
	 * Entradas progresivas para las cards y los textos.
	 * Las animaciones usan transforms visuales: no cambian el flujo,
	 * las medidas ni la posición final de ningún componente.
	 */
	const entranceSections =
		document.querySelectorAll<HTMLElement>(
			'[data-reveal]'
		);

	const entranceCardSelector = [
		'.story__photo-wrap',
		'.story__content',
		'.countdown-heading',
		'.event-countdown__item',
		'.countdown-button',
		'.gallery__item',
		'.event__summary-card',
		'.timeline__item',
		'.location__card',
		'.location__pin',
		'.location-button',
		'.dress-code .section-heading',
		'.dress-code__card',
		'.dress-code__colors',
		'.notices__grid article',
		'.rsvp-form',
		'.rsvp-form__submit',
		'.closing__content',
	].join(',');

	const entranceTextSelector = [
		'.section-heading > span',
		'.section-heading > h2',
		'.section-heading > p',
		'.story__heading > span',
		'.story__heading h3',
		'.story__text',
		'.story__signature',
		'.event-countdown__item strong',
		'.event-countdown__item > span',
		'.event__summary-card > span',
		'.event__summary-card > strong',
		'.timeline__item time',
		'.timeline__item h3',
		'.timeline__item p',
		'.location__eyebrow',
		'.location__heading > span',
		'.location__heading h2',
		'.location__heading p',
		'.dress-code__card > strong',
		'.dress-code__card > p',
		'.dress-code__card > small',
		'.notices__grid h3',
		'.notices__grid p',
		'.rsvp-form label',
		'.closing__content > span',
		'.closing__content h2',
		'.closing__content > p',
		'.closing__content > time',
	].join(',');

	const reducedMotion =
		window.matchMedia(
			'(prefers-reduced-motion: reduce)'
		).matches;

	let entranceObserver:
		| IntersectionObserver
		| undefined;

	if (
		!reducedMotion &&
		'IntersectionObserver' in window &&
		'animate' in Element.prototype
	) {
		const animationsBySection =
			new Map<HTMLElement, Animation[]>();

		entranceSections.forEach(
			(section) => {
				const animations: Animation[] = [];

				section
					.querySelectorAll<HTMLElement>(
						entranceCardSelector
					)
					.forEach(
						(card, index) => {
							const animation =
								card.animate(
									[
										{
											opacity: 0,
											transform:
												'translateY(1.35rem) scale(0.985)',
										},
										{
											opacity: 1,
											transform:
												'translateY(0) scale(1)',
										},
									],
									{
										duration: 820,
										delay:
											Math.min(
												index * 85,
												340
											),
										easing:
											'cubic-bezier(0.22, 1, 0.36, 1)',
										fill: 'both',
									}
								);

							animation.pause();
							animations.push(animation);
						}
					);

				section
					.querySelectorAll<HTMLElement>(
						entranceTextSelector
					)
					.forEach(
						(element, index) => {
							const animation =
								element.animate(
									[
										{
											opacity: 0,
											transform:
												'translateY(0.65rem)',
										},
										{
											opacity: 1,
											transform:
												'translateY(0)',
										},
									],
									{
										duration: 680,
										delay:
											160 +
											Math.min(
												index * 42,
												420
											),
										easing:
											'cubic-bezier(0.22, 1, 0.36, 1)',
										fill: 'both',
									}
								);

							animation.pause();
							animations.push(animation);
						}
					);

				if (animations.length > 0) {
					animationsBySection.set(
						section,
						animations
					);
				}
			}
		);

		entranceObserver =
			new IntersectionObserver(
				(entries) => {
					entries.forEach(
						(entry) => {
							if (!entry.isIntersecting) {
								return;
							}

							const section =
								entry.target as HTMLElement;

							const animations =
								animationsBySection.get(
									section
								) ?? [];

							animations.forEach(
								(animation) => {
									animation.play();

									void animation.finished
										.then(
											() => {
												animation.cancel();
											}
										)
										.catch(
											() => {}
										);
								}
							);

							entranceObserver?.unobserve(
								section
							);
						}
					);
				},
				{
					threshold: 0.1,
					rootMargin:
						'0px 0px -4% 0px',
				}
			);

		animationsBySection.forEach(
			(_, section) => {
				entranceObserver?.observe(
					section
				);
			}
		);

		document.addEventListener(
			'astro:before-swap',
			() => {
				entranceObserver?.disconnect();

				animationsBySection.forEach(
					(animations) => {
						animations.forEach(
							(animation) => {
								animation.cancel();
							}
						);
					}
				);
			},
			{
				once: true,
			}
		);
	}

</script>

<style>
	.music-button {
		position: fixed;
		z-index: 50;
		top: max(1rem, env(safe-area-inset-top));
		right: 1rem;
		width: 2.9rem;
		height: 2.9rem;
		padding: 0;
		border: 1px solid #dec7ad;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background:
			linear-gradient(
				145deg,
				rgba(109, 104, 83, 0.78),
				rgba(40, 25, 10, 0.42)
			);
		color: #fefcf8;
		font-size: 1.15rem;
		box-shadow:
			inset 0 1px 0 rgba(254, 252, 248, 0.5),
			0 0.65rem 1.6rem rgba(40, 25, 10, 0.2);
		-webkit-backdrop-filter: blur(12px) saturate(120%);
		backdrop-filter: blur(12px) saturate(120%);
		opacity: 0;
		visibility: hidden;
		cursor: pointer;
		transition: 350ms ease;
	}

	.music-button.is-visible {
		visibility: visible;
		opacity: 1;
	}

	.music-button.is-paused {
		background: rgba(254, 252, 248, 0.74);
		color: #a57a4f;
		transform: scale(0.92);
	}

	.music-button:focus-visible {
		outline: 2px solid #fefcf8;
		outline-offset: 3px;
	}
</style>
