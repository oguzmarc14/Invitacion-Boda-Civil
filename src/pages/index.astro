---
import Welcome from '../components/Welcome.astro';
import Home from '../components/Home.astro';
import Layout from '../layouts/Layout.astro';

const invitation = {
	novia: 'Andrea',
	novio: 'Carlos',
	fecha: '31.12.2027',
	fechaObjetivo: '2027-12-31T17:00:00-06:00',
	titulo: 'Boda civil',
	mensajeInvitacion:
		'Con inmensa alegría queremos invitarte a compartir con nosotros el comienzo de esta nueva etapa de nuestras vidas.',
	imagen: '/images/welcome-couple.webp',
	cancion: '',
};
---

<Layout title={`${invitation.novio} & ${invitation.novia} | Nuestra boda`}>
	<Welcome
		novia={invitation.novia}
		novio={invitation.novio}
		fecha={invitation.fecha}
		fechaObjetivo={invitation.fechaObjetivo}
		imagen={invitation.imagen}
		tieneMusica={Boolean(invitation.cancion)}
	/>

	<Home
		novia={invitation.novia}
		novio={invitation.novio}
		fecha={invitation.fecha}
		fechaObjetivo={invitation.fechaObjetivo}
		titulo={invitation.titulo}
		mensajeInvitacion={invitation.mensajeInvitacion}
	/>

	{
		invitation.cancion && (
			<>
				<audio id="wedding-music" src={invitation.cancion} preload="auto" loop></audio>
				<button class="music-button" type="button" data-music-button aria-label="Pausar música">
					<span aria-hidden="true">♫</span>
				</button>
			</>
		)
	}
</Layout>

<script>
	const audio = document.querySelector<HTMLAudioElement>('#wedding-music');
	const musicButton = document.querySelector<HTMLButtonElement>('[data-music-button]');

	window.addEventListener('invitation:open', async () => {
		if (!audio) return;
		musicButton?.classList.add('is-visible');

		try {
			await audio.play();
		} catch {
			musicButton?.classList.add('is-paused');
		}
	});

	musicButton?.addEventListener('click', async () => {
		if (!audio) return;

		if (audio.paused) {
			await audio.play();
			musicButton.classList.remove('is-paused');
			musicButton.setAttribute('aria-label', 'Pausar música');
		} else {
			audio.pause();
			musicButton.classList.add('is-paused');
			musicButton.setAttribute('aria-label', 'Reproducir música');
		}
	});
</script>

<style>
	.music-button {
		position: fixed;
		z-index: 50;
		top: max(1rem, env(safe-area-inset-top));
		right: 1rem;
		width: 2.9rem;
		height: 2.9rem;
		padding: 0;
		border: 1px solid #dec7ad;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgba(109, 104, 83, 0.92);
		color: #fefcf8;
		font-size: 1.15rem;
		opacity: 0;
		visibility: hidden;
		cursor: pointer;
		transition: 350ms ease;
	}

	.music-button.is-visible {
		visibility: visible;
		opacity: 1;
	}

	.music-button.is-paused {
		background: rgba(254, 252, 248, 0.92);
		color: #a57a4f;
		transform: scale(0.92);
	}
</style>
