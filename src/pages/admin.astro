---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Panel de invitados | Nayzeth & Adán"
	description="Panel privado para administrar las invitaciones."
>
	<main class="admin-shell">
		<section class="login-layout" data-login-panel>
			<div class="login-brand">
				<div class="brand-mark" aria-hidden="true">N &amp; A</div>
				<span>Panel privado</span>
				<h1>Invitados de nuestra boda</h1>
				<p>Un espacio sencillo para crear, enviar y administrar cada invitación.</p>
			</div>

			<div class="login-card">
				<span class="eyebrow">Acceso administrativo</span>
				<h2>Bienvenida</h2>
				<p>Ingresa con la cuenta autorizada para continuar.</p>

				<form data-login-form>
					<label>
						Correo electrónico
						<input type="email" name="email" autocomplete="email" required />
					</label>

					<label>
						Contraseña
						<input
							type="password"
							name="password"
							autocomplete="current-password"
							minlength="8"
							required
						/>
					</label>

					<button class="button button--primary button--full" type="submit">
						Entrar al panel
					</button>
				</form>

				<p class="feedback" data-login-feedback aria-live="polite"></p>
			</div>
		</section>

		<section class="dashboard" data-dashboard hidden>
			<aside class="admin-sidebar">
				<div class="sidebar-brand">
					<div class="sidebar-brand__mark" aria-hidden="true">N &amp; A</div>
					<div>
						<strong>Nayzeth &amp; Adán</strong>
						<span>Panel de invitados</span>
					</div>
				</div>

				<nav class="admin-nav" aria-label="Menú administrativo">
					<button class="admin-nav__item is-active" type="button" data-view-target="overview">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"></path></svg>
						<span>Resumen</span>
					</button>

					<button class="admin-nav__item" type="button" data-view-target="create">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
						<span>Nueva invitación</span>
					</button>

					<button class="admin-nav__item" type="button" data-view-target="guests">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 20v-1.6c0-2.1-1.8-3.9-4-3.9H7c-2.2 0-4 1.8-4 3.9V20M9.5 10.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM16 11l2 2 4-4"></path></svg>
						<span>Todos los invitados</span>
					</button>

					<button class="admin-nav__item" type="button" data-view-target="account">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"></path></svg>
						<span>Mi cuenta</span>
					</button>
				</nav>

				<div class="sidebar-footer">
					<span>Boda civil · 05.02.2027</span>
					<button class="button button--sidebar" type="button" data-logout>
						Cerrar sesión
					</button>
				</div>
			</aside>

			<div class="admin-workspace">
				<header class="workspace-header">
					<div>
						<span class="eyebrow" data-view-eyebrow>Vista general</span>
						<h1 data-view-title>Resumen de invitados</h1>
						<p data-view-description>Consulta rápidamente el avance de las confirmaciones.</p>
					</div>

					<button class="button button--ghost workspace-logout" type="button" data-logout>
						Salir
					</button>
				</header>

				<section class="admin-view" data-view="overview">
					<div class="stats" aria-label="Resumen de invitados">
						<article>
							<span>Invitaciones</span>
							<strong data-stat-invitations>0</strong>
							<small>Familias y personas</small>
						</article>
						<article>
							<span>Personas permitidas</span>
							<strong data-stat-allowed>0</strong>
							<small>Cupo total enviado</small>
						</article>
						<article>
							<span>Asistentes confirmados</span>
							<strong data-stat-confirmed>0</strong>
							<small>Personas que asistirán</small>
						</article>
						<article>
							<span>Pendientes</span>
							<strong data-stat-pending>0</strong>
							<small>Invitaciones sin respuesta</small>
						</article>
					</div>

					<div class="overview-grid">
						<article class="overview-card overview-card--progress">
							<span class="eyebrow">Estado de respuestas</span>
							<h2>Avance de confirmaciones</h2>
							<div class="response-rate">
								<strong data-stat-response-rate>0%</strong>
								<span>de invitaciones respondidas</span>
							</div>
							<div class="progress-track" aria-hidden="true">
								<span data-response-progress></span>
							</div>
							<div class="response-legend">
								<span><i class="legend-dot legend-dot--confirmed"></i><strong data-status-confirmed>0</strong> confirmadas</span>
								<span><i class="legend-dot legend-dot--pending"></i><strong data-status-pending>0</strong> pendientes</span>
								<span><i class="legend-dot legend-dot--declined"></i><strong data-status-declined>0</strong> no asistirán</span>
							</div>
						</article>

						<article class="overview-card overview-card--actions">
							<span class="eyebrow">Acciones rápidas</span>
							<h2>¿Qué deseas hacer?</h2>
							<button class="quick-action" type="button" data-view-target="create">
								<span class="quick-action__icon">+</span>
								<span><strong>Crear una invitación</strong><small>Registra una persona o familia</small></span>
								<span aria-hidden="true">→</span>
							</button>
							<button class="quick-action" type="button" data-view-target="guests">
								<span class="quick-action__icon">⌕</span>
								<span><strong>Buscar invitados</strong><small>Consulta, edita o comparte enlaces</small></span>
								<span aria-hidden="true">→</span>
							</button>
						</article>
					</div>
				</section>

				<section class="admin-view" data-view="create" hidden>
					<div class="form-layout">
						<article class="form-introduction">
							<span class="eyebrow" data-form-eyebrow>Nueva invitación</span>
							<h2 data-form-title>Agregar familia o invitado</h2>
							<p>Cada registro genera un enlace único. Define el nombre, el cupo autorizado y, si deseas enviarlo directamente, su teléfono de WhatsApp.</p>
							<div class="form-tip">
								<strong>Consejo</strong>
								<span>Utiliza “Familia + apellido” cuando varias personas compartirán la misma invitación.</span>
							</div>
						</article>

						<article class="panel-card panel-card--form">
							<form data-invitation-form>
								<input type="hidden" name="id" />

								<label>
									Nombre de la invitación
									<input type="text" name="name" placeholder="Ej. Familia López" required />
								</label>

								<label>
									Personas permitidas
									<input type="number" name="allowed" min="1" max="20" value="1" required />
									<small>El invitado no podrá confirmar más personas que esta cantidad.</small>
								</label>

								<label>
									Teléfono de WhatsApp
									<input type="tel" name="phone" inputmode="tel" placeholder="5214491234567" />
									<small>Incluye el código de país para habilitar el envío directo.</small>
								</label>

								<div class="form-actions">
									<button class="button button--primary" type="submit" data-save-button>Crear invitación</button>
									<button class="button button--ghost" type="button" data-cancel-edit hidden>Cancelar edición</button>
								</div>
							</form>

							<p class="feedback" data-form-feedback aria-live="polite"></p>
						</article>
					</div>
				</section>

				<section class="admin-view" data-view="guests" hidden>
					<article class="panel-card panel-card--list">
						<div class="list-heading">
							<div>
								<span class="eyebrow">Directorio</span>
								<h2>Invitaciones registradas</h2>
								<p><span data-result-count>0</span> resultados</p>
							</div>

							<button class="button button--ghost" type="button" data-refresh>Actualizar</button>
						</div>

						<div class="guest-toolbar">
							<label class="search-field">
								<span class="sr-only">Buscar persona o familia</span>
								<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg>
								<input type="search" placeholder="Buscar persona, familia, código o teléfono…" data-guest-search />
							</label>

							<label class="filter-field">
								<span class="sr-only">Filtrar por estado</span>
								<select data-status-filter>
									<option value="all">Todos los estados</option>
									<option value="pendiente">Pendientes</option>
									<option value="confirmado">Confirmados</option>
									<option value="no_asiste">No asistirán</option>
								</select>
							</label>
						</div>

						<p class="feedback" data-list-feedback aria-live="polite"></p>
						<div class="guest-list" data-guest-list></div>
					</article>
				</section>

				<section class="admin-view" data-view="account" hidden>
					<article class="panel-card account-card">
						<span class="eyebrow">Seguridad</span>
						<h2>Cambiar contraseña</h2>
						<p>Utiliza una contraseña de al menos ocho caracteres y evita compartirla con otras personas.</p>

						<form data-password-form>
							<label>
								Nueva contraseña
								<input type="password" name="password" minlength="8" autocomplete="new-password" required />
							</label>
							<button class="button button--primary" type="submit">Actualizar contraseña</button>
						</form>
						<p class="feedback" data-password-feedback aria-live="polite"></p>
					</article>
				</section>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { supabase } from '../lib/supabase';

	type Invitado = {
		id: string;
		nombre_invitado: string;
		codigo: string;
		invitados_permitidos: number;
		asistentes_confirmados: number;
		estado: 'pendiente' | 'confirmado' | 'no_asiste';
		telefono: string | null;
		fecha_confirmacion: string | null;
		created_at: string;
	};

	const loginPanel = document.querySelector<HTMLElement>('[data-login-panel]');
	const dashboard = document.querySelector<HTMLElement>('[data-dashboard]');
	const logoutButtons = document.querySelectorAll<HTMLButtonElement>('[data-logout]');
	const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
	const invitationForm = document.querySelector<HTMLFormElement>('[data-invitation-form]');
	const passwordForm = document.querySelector<HTMLFormElement>('[data-password-form]');
	const guestList = document.querySelector<HTMLElement>('[data-guest-list]');
	const loginFeedback = document.querySelector<HTMLElement>('[data-login-feedback]');
	const formFeedback = document.querySelector<HTMLElement>('[data-form-feedback]');
	const listFeedback = document.querySelector<HTMLElement>('[data-list-feedback]');
	const passwordFeedback = document.querySelector<HTMLElement>('[data-password-feedback]');
	const saveButton = document.querySelector<HTMLButtonElement>('[data-save-button]');
	const cancelEditButton = document.querySelector<HTMLButtonElement>('[data-cancel-edit]');
	const formEyebrow = document.querySelector<HTMLElement>('[data-form-eyebrow]');
	const formTitle = document.querySelector<HTMLElement>('[data-form-title]');
	const guestSearch = document.querySelector<HTMLInputElement>('[data-guest-search]');
	const statusFilter = document.querySelector<HTMLSelectElement>('[data-status-filter]');
	const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
	const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view-target]');
	const navigationButtons = document.querySelectorAll<HTMLButtonElement>('.admin-nav__item');
	const views = document.querySelectorAll<HTMLElement>('[data-view]');
	const viewEyebrow = document.querySelector<HTMLElement>('[data-view-eyebrow]');
	const viewTitle = document.querySelector<HTMLElement>('[data-view-title]');
	const viewDescription = document.querySelector<HTMLElement>('[data-view-description]');

	let guests: Invitado[] = [];
	let activeView = 'overview';

	const viewMetadata: Record<string, { eyebrow: string; title: string; description: string }> = {
		overview: {
			eyebrow: 'Vista general',
			title: 'Resumen de invitados',
			description: 'Consulta rápidamente el avance de las confirmaciones.',
		},
		create: {
			eyebrow: 'Invitaciones',
			title: 'Crear nueva invitación',
			description: 'Genera un enlace personalizado para una persona o familia.',
		},
		guests: {
			eyebrow: 'Directorio',
			title: 'Todos los invitados',
			description: 'Busca, filtra y administra cada invitación registrada.',
		},
		account: {
			eyebrow: 'Configuración',
			title: 'Mi cuenta',
			description: 'Administra la seguridad del acceso al panel.',
		},
	};

	const showView = (viewName: string) => {
		const metadata = viewMetadata[viewName];
		if (!metadata) return;

		activeView = viewName;

		views.forEach((view) => {
			view.hidden = view.dataset.view !== viewName;
		});

		navigationButtons.forEach((button) => {
			const isActive = button.dataset.viewTarget === viewName;
			button.classList.toggle('is-active', isActive);
			button.setAttribute('aria-current', isActive ? 'page' : 'false');
		});

		if (viewEyebrow) viewEyebrow.textContent = metadata.eyebrow;
		if (viewTitle) viewTitle.textContent = metadata.title;
		if (viewDescription) viewDescription.textContent = metadata.description;

		window.scrollTo({ top: 0, behavior: 'smooth' });
	};

	const setFeedback = (
		element: HTMLElement | null,
		message: string,
		status: 'success' | 'error' | 'info' = 'info'
	) => {
		if (!element) return;
		element.textContent = message;
		element.dataset.status = status;
	};

	const escapeHtml = (value: string) =>
		value.replace(
			/[&<>'"]/g,
			(character) =>
				({
					'&': '&amp;',
					'<': '&lt;',
					'>': '&gt;',
					"'": '&#39;',
					'"': '&quot;',
				})[character] ?? character
		);

	const invitationUrl = (code: string) =>
		`${window.location.origin}/i/${encodeURIComponent(code)}`;

	const formatDate = (date: string | null) => {
		if (!date) return 'Sin confirmar';

		return new Intl.DateTimeFormat('es-MX', {
			dateStyle: 'medium',
			timeStyle: 'short',
		}).format(new Date(date));
	};

	const statusLabel = (status: Invitado['estado']) =>
		({
			pendiente: 'Pendiente',
			confirmado: 'Confirmado',
			no_asiste: 'No asistirá',
		})[status];

	const updateStats = () => {
		const confirmedInvitations = guests.filter(
			(guest) => guest.estado === 'confirmado'
		).length;
		const pendingInvitations = guests.filter(
			(guest) => guest.estado === 'pendiente'
		).length;
		const declinedInvitations = guests.filter(
			(guest) => guest.estado === 'no_asiste'
		).length;
		const responseRate = guests.length
			? Math.round(((confirmedInvitations + declinedInvitations) / guests.length) * 100)
			: 0;

		const values = {
			'[data-stat-invitations]': guests.length,
			'[data-stat-allowed]': guests.reduce(
				(total, guest) => total + guest.invitados_permitidos,
				0
			),
			'[data-stat-confirmed]': guests.reduce(
				(total, guest) => total + guest.asistentes_confirmados,
				0
			),
			'[data-stat-pending]': pendingInvitations,
			'[data-status-confirmed]': confirmedInvitations,
			'[data-status-pending]': pendingInvitations,
			'[data-status-declined]': declinedInvitations,
		};

		Object.entries(values).forEach(([selector, value]) => {
			const element = document.querySelector<HTMLElement>(selector);
			if (element) element.textContent = String(value);
		});

		const rateElement = document.querySelector<HTMLElement>('[data-stat-response-rate]');
		const progressElement = document.querySelector<HTMLElement>('[data-response-progress]');

		if (rateElement) rateElement.textContent = `${responseRate}%`;
		if (progressElement) progressElement.style.width = `${responseRate}%`;
	};

	const normalizedText = (value: string) =>
		value
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase();

	const filteredGuests = () => {
		const query = normalizedText(guestSearch?.value.trim() ?? '');
		const selectedStatus = statusFilter?.value ?? 'all';

		return guests.filter((guest) => {
			const matchesStatus =
				selectedStatus === 'all' || guest.estado === selectedStatus;
			const searchableValue = normalizedText(
				[
					guest.nombre_invitado,
					guest.codigo,
					guest.telefono ?? '',
				].join(' ')
			);

			return matchesStatus && (!query || searchableValue.includes(query));
		});
	};

	const renderGuests = () => {
		if (!guestList) return;
		const visibleGuests = filteredGuests();

		if (resultCount) {
			resultCount.textContent = String(visibleGuests.length);
		}

		if (guests.length === 0) {
			guestList.innerHTML = `
				<div class="empty-state">
					<span class="empty-state__icon">＋</span>
					<strong>Aún no hay invitaciones</strong>
					<span>Crea la primera desde el menú “Nueva invitación”.</span>
				</div>
			`;
			updateStats();
			return;
		}

		if (visibleGuests.length === 0) {
			guestList.innerHTML = `
				<div class="empty-state">
					<span class="empty-state__icon">⌕</span>
					<strong>No encontramos coincidencias</strong>
					<span>Prueba con otro nombre, apellido, código o teléfono.</span>
				</div>
			`;
			updateStats();
			return;
		}

		guestList.innerHTML = visibleGuests
			.map((guest) => {
				const safeName = escapeHtml(guest.nombre_invitado);
				const safeCode = escapeHtml(guest.codigo);
				const safePhone = escapeHtml(guest.telefono ?? 'Sin teléfono');

				return `
					<article class="guest-card">
						<div class="guest-card__header">
							<div class="guest-card__identity">
								<span class="status status--${guest.estado}">${statusLabel(guest.estado)}</span>
								<h3>${safeName}</h3>
								<small>${safeCode}</small>
							</div>
							<button class="icon-button" type="button" data-action="edit" data-id="${guest.id}" aria-label="Editar ${safeName}">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16-.8 4.8L8 20l11-11-4-4L4 16ZM13.5 6.5l4 4"></path></svg>
							</button>
						</div>

						<div class="guest-card__summary">
							<div><span>Cupo</span><strong>${guest.invitados_permitidos}</strong></div>
							<div><span>Confirmados</span><strong>${guest.asistentes_confirmados}</strong></div>
							<div><span>Respuesta</span><strong>${formatDate(guest.fecha_confirmacion)}</strong></div>
						</div>

						<div class="guest-card__phone">
							<span>WhatsApp</span>
							<strong>${safePhone}</strong>
						</div>

						<div class="guest-card__actions">
							<button class="action-button action-button--copy" type="button" data-action="copy" data-id="${guest.id}">
								<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>
								<span>Copiar enlace</span>
							</button>
							<button class="action-button action-button--whatsapp" type="button" data-action="whatsapp" data-id="${guest.id}" ${guest.telefono ? '' : 'disabled'}>
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.6a8 8 0 0 1-11.8 7L4 20l1.4-4.1A8 8 0 1 1 20 11.6Z"></path><path d="M9 8.5c.4 2.5 2 4.1 4.5 4.5"></path></svg>
								<span>Enviar por WhatsApp</span>
							</button>
							<button class="action-button action-button--delete" type="button" data-action="delete" data-id="${guest.id}">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"></path></svg>
								<span>Eliminar</span>
							</button>
						</div>
					</article>
				`;
			})
			.join('');

		updateStats();
	};

	const loadGuests = async () => {
		setFeedback(listFeedback, 'Cargando invitaciones...');

		const { data, error } = await supabase
			.from('invitados')
			.select('*')
			.order('created_at', { ascending: false });

		if (error) {
			setFeedback(
				listFeedback,
				'No tienes permisos administrativos o no fue posible cargar la lista.',
				'error'
			);
			return;
		}

		guests = (data ?? []) as Invitado[];
		setFeedback(listFeedback, '');
		renderGuests();
	};

	const showSession = async (isAuthenticated: boolean) => {
		if (loginPanel) loginPanel.hidden = isAuthenticated;
		if (dashboard) dashboard.hidden = !isAuthenticated;

		if (isAuthenticated) {
			showView(activeView);
			await loadGuests();
		}
	};

	const resetInvitationForm = () => {
		invitationForm?.reset();

		const idInput = invitationForm?.elements.namedItem('id') as HTMLInputElement | null;
		const allowedInput = invitationForm?.elements.namedItem('allowed') as HTMLInputElement | null;

		if (idInput) idInput.value = '';
		if (allowedInput) allowedInput.value = '1';
		if (saveButton) saveButton.textContent = 'Crear invitación';
		if (cancelEditButton) cancelEditButton.hidden = true;
		if (formEyebrow) formEyebrow.textContent = 'Nueva invitación';
		if (formTitle) formTitle.textContent = 'Agregar familia o invitado';
		setFeedback(formFeedback, '');
	};

	const createCode = (name: string) => {
		const slug = name
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-|-$/g, '')
			.slice(0, 36) || 'invitacion';

		const random = crypto.randomUUID().replaceAll('-', '').slice(0, 10);
		return `${slug}-${random}`;
	};

	loginForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const formData = new FormData(loginForm);
		const email = String(formData.get('email') ?? '').trim();
		const password = String(formData.get('password') ?? '');

		setFeedback(loginFeedback, 'Verificando acceso...');

		const { error } = await supabase.auth.signInWithPassword({ email, password });

		if (error) {
			setFeedback(loginFeedback, 'El correo o la contraseña no son correctos.', 'error');
			return;
		}

		loginForm.reset();
		setFeedback(loginFeedback, '');
		await showSession(true);
	});

	logoutButtons.forEach((button) => {
		button.addEventListener('click', async () => {
			await supabase.auth.signOut();
			guests = [];
			renderGuests();
			await showSession(false);
		});
	});

	viewButtons.forEach((button) => {
		button.addEventListener('click', () => {
			showView(button.dataset.viewTarget ?? 'overview');
		});
	});

	invitationForm?.addEventListener('submit', async (event) => {
		event.preventDefault();

		const formData = new FormData(invitationForm);
		const id = String(formData.get('id') ?? '');
		const name = String(formData.get('name') ?? '').trim();
		const allowed = Number(formData.get('allowed'));
		const phone = String(formData.get('phone') ?? '').replace(/\D/g, '');
		const existingGuest = guests.find((guest) => guest.id === id);

		if (!name || !Number.isInteger(allowed) || allowed < 1 || allowed > 20) {
			setFeedback(formFeedback, 'Revisa el nombre y la cantidad permitida.', 'error');
			return;
		}

		if (existingGuest && allowed < existingGuest.asistentes_confirmados) {
			setFeedback(
				formFeedback,
				'La cantidad permitida no puede ser menor que los asistentes ya confirmados.',
				'error'
			);
			return;
		}

		if (saveButton) saveButton.disabled = true;
		setFeedback(formFeedback, id ? 'Guardando cambios...' : 'Creando invitación...');

		const payload = {
			nombre_invitado: name,
			invitados_permitidos: allowed,
			telefono: phone || null,
		};

		const result = id
			? await supabase.from('invitados').update(payload).eq('id', id)
			: await supabase.from('invitados').insert({
					...payload,
					codigo: createCode(name),
					asistentes_confirmados: 0,
					estado: 'pendiente',
				});

		if (saveButton) saveButton.disabled = false;

		if (result.error) {
			setFeedback(formFeedback, 'No fue posible guardar la invitación.', 'error');
			return;
		}

		const successMessage = id
			? 'Los cambios se guardaron correctamente.'
			: 'La invitación fue creada correctamente.';

		resetInvitationForm();
		await loadGuests();
		showView('guests');
		setFeedback(listFeedback, successMessage, 'success');
	});

	cancelEditButton?.addEventListener('click', resetInvitationForm);
	document.querySelector('[data-refresh]')?.addEventListener('click', loadGuests);
	guestSearch?.addEventListener('input', renderGuests);
	statusFilter?.addEventListener('change', renderGuests);

	guestList?.addEventListener('click', async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
		if (!button) return;

		const guest = guests.find((item) => item.id === button.dataset.id);
		if (!guest) return;

		switch (button.dataset.action) {
			case 'copy': {
				await navigator.clipboard.writeText(invitationUrl(guest.codigo));
				const label = button.querySelector('span');
				const previous = label?.textContent ?? 'Copiar enlace';
				if (label) label.textContent = 'Enlace copiado';
				window.setTimeout(() => {
					if (label) label.textContent = previous;
				}, 1600);
				break;
			}

			case 'whatsapp': {
				if (!guest.telefono) return;
				const message = [
					`Hola ${guest.nombre_invitado},`,
					'con mucha alegría queremos compartir nuestra invitación de boda contigo:',
					invitationUrl(guest.codigo),
				].join('\n\n');

				window.open(
					`https://wa.me/${guest.telefono.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`,
					'_blank',
					'noopener,noreferrer'
				);
				break;
			}

			case 'edit': {
				if (!invitationForm) return;
				showView('create');
				(invitationForm.elements.namedItem('id') as HTMLInputElement).value = guest.id;
				(invitationForm.elements.namedItem('name') as HTMLInputElement).value = guest.nombre_invitado;
				(invitationForm.elements.namedItem('allowed') as HTMLInputElement).value = String(guest.invitados_permitidos);
				(invitationForm.elements.namedItem('phone') as HTMLInputElement).value = guest.telefono ?? '';
				if (saveButton) saveButton.textContent = 'Guardar cambios';
				if (cancelEditButton) cancelEditButton.hidden = false;
				if (formEyebrow) formEyebrow.textContent = 'Editar invitación';
				if (formTitle) formTitle.textContent = guest.nombre_invitado;
				invitationForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
				break;
			}

			case 'delete': {
				if (!window.confirm(`¿Eliminar la invitación de ${guest.nombre_invitado}?`)) return;
				const { error } = await supabase.from('invitados').delete().eq('id', guest.id);

				if (error) {
					setFeedback(listFeedback, 'No fue posible eliminar la invitación.', 'error');
					return;
				}

				await loadGuests();
				break;
			}
		}
	});

	passwordForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const formData = new FormData(passwordForm);
		const password = String(formData.get('password') ?? '');

		const { error } = await supabase.auth.updateUser({ password });

		if (error) {
			setFeedback(passwordFeedback, 'No fue posible actualizar la contraseña.', 'error');
			return;
		}

		passwordForm.reset();
		setFeedback(passwordFeedback, 'La contraseña fue actualizada.', 'success');
	});

	const { data: sessionData } = await supabase.auth.getSession();
	await showSession(Boolean(sessionData.session));

	supabase.auth.onAuthStateChange((_event, session) => {
		window.setTimeout(() => {
			void showSession(Boolean(session));
		}, 0);
	});
</script>

