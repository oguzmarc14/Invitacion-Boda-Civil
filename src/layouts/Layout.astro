---
import '@fontsource/parisienne/400.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Invitación de boda civil',
	description = 'Acompáñanos a celebrar el comienzo de nuestra historia.',
	image = '/images/galeria/boda_01.webp',
} = Astro.props;

const productionOrigin = 'https://invitacion-boda-civil.vercel.app';
const pageUrl = new URL(Astro.url.pathname, productionOrigin).toString();
const imageUrl = new URL(image, productionOrigin).toString();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#28190A" />
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content="Nayzeth y Adán · Nuestra boda civil" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<link rel="canonical" href={pageUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--warm-white: #fefcf8;
		--ivory: #ece4d9;
		--champagne: #dec7ad;
		--golden-sand: #c69c70;
		--honey-wood: #a57a4f;
		--warm-coffee: #704c32;
		--olive-gray: #6d6853;
		--espresso: #28190a;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		width: 100%;
		min-width: 320px;
		min-height: 100%;
		margin: 0;
		background: var(--warm-white);
		color: var(--espresso);
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		overflow-x: hidden;
		font-family: Georgia, 'Times New Roman', serif;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}
</style>
